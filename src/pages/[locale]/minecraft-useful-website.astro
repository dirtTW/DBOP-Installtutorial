---
import RedirectPage from "../../components/RedirectPage.astro";
import { locales, localizedPath } from "../../i18n";

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== "en")
    .map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
const destination = localizedPath(locale, "useful-website");
---

<RedirectPage destination={destination} lang={locale} label="Continue to useful websites" />
