---
import { getSiteLabel } from "../i18n";

interface Props {
  link: string;
  altText: string;
  locale?: string;
}
const { altText, link, locale } = Astro.props;
const label = getSiteLabel(locale ?? Astro.currentLocale, link, altText);
---

<a
  class="group flex min-h-20 items-center gap-4 rounded-2xl border border-zinc-200 bg-white p-4 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-800/30 hover:shadow-lg hover:shadow-zinc-900/5 focus:outline-none focus:ring-2 focus:ring-emerald-600 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-emerald-300/30 dark:hover:bg-zinc-800"
  href={link}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-900/5 text-emerald-800 dark:bg-emerald-300/10 dark:text-emerald-300" aria-hidden="true">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3h7v7m-1-6-9 9"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
  </span>
  <span class="min-w-0 flex-1 text-sm font-semibold leading-5 text-zinc-800 group-hover:text-emerald-900 dark:text-zinc-100 dark:group-hover:text-emerald-200">{label}</span>
  <span aria-hidden="true" class="text-zinc-400 transition group-hover:translate-x-0.5 group-hover:text-emerald-700 dark:group-hover:text-emerald-300">↗</span>
</a>
