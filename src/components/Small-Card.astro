---
import { getSiteLabel } from "../i18n";

interface Props {
  link: string;
  altText: string;
  locale?: string;
  categories?: string[];
}
const { altText, link, locale, categories = [] } = Astro.props;
const label = getSiteLabel(locale ?? Astro.currentLocale, link, altText);
---

<a
  class="site-card surface-card group flex min-h-20 items-center gap-4 p-4 text-left"
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  data-categories={categories.join(" ")}
>
  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[var(--md-sys-color-surface-container-high)] text-[var(--md-sys-color-primary)]" aria-hidden="true">
    <span class="material-symbols-outlined text-xl">language</span>
  </span>
  <span class="min-w-0 flex-1 text-sm font-semibold leading-5 text-[var(--md-sys-color-on-surface)]">{label}</span>
  <span class="material-symbols-outlined text-xl text-[var(--md-sys-color-on-surface-variant)] transition-colors group-hover:text-[var(--md-sys-color-primary)]" aria-hidden="true">open_in_new</span>
</a>

<style>
  .site-card {
    transition:
      background-color 180ms cubic-bezier(0.2, 0, 0, 1),
      box-shadow 180ms cubic-bezier(0.2, 0, 0, 1);
  }

  .site-card:hover {
    background-color: color-mix(
      in srgb,
      var(--md-sys-color-on-surface) 5%,
      var(--md-sys-color-surface-container-low)
    );
    box-shadow:
      0 1px 3px 1px rgb(0 0 0 / 0.12),
      0 1px 2px rgb(0 0 0 / 0.24);
  }
</style>
