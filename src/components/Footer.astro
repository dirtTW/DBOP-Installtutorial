---
import { getLocale, getMessages } from "../i18n";

const t = getMessages(getLocale(Astro.props.locale));
---

<footer
  class="mt-auto border-t border-[var(--md-sys-color-outline-variant)] bg-[var(--md-sys-color-surface-container-low)] px-5 py-8 sm:px-8"
>
  <div class="mx-auto flex max-w-screen-xl flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
    <span class="text-sm leading-5 text-[var(--md-sys-color-on-surface-variant)]">
      © 2026{" "}
      <a
        href="https://github.com/dirttw"
        class="font-semibold text-[var(--md-sys-color-on-surface)] hover:text-[var(--md-sys-color-primary)] hover:underline"
      >
        dirtTW
      </a>
      . {t.footer.rights}
    </span>
    <ul class="flex flex-wrap items-center gap-2">
      <li>
        <md-text-button
          href="https://discord.gg/7upZWA82Zk"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg slot="icon" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.7 5.3a18 18 0 0 0-4.4-1.4l-.6 1.2a16.7 16.7 0 0 0-5.4 0l-.6-1.2a18 18 0 0 0-4.4 1.4C1.5 9.5.7 13.6 1.1 17.7a18 18 0 0 0 5.4 2.7l1.2-2a11.7 11.7 0 0 1-1.9-.9l.5-.4a12.8 12.8 0 0 0 11.4 0l.5.4a11.7 11.7 0 0 1-1.9.9l1.2 2a18 18 0 0 0 5.4-2.7c.5-4.8-.8-8.8-3.2-12.4ZM8.7 14.8c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm6.6 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z"></path>
          </svg>
          {t.footer.discord}
        </md-text-button>
      </li>
      <li>
        <md-text-button
          href="https://github.com/dirttw/DBOP-Installtutorial"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg slot="icon" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .8a11.2 11.2 0 0 0-3.5 21.8c.6.1.8-.3.8-.6v-2.1c-3.1.7-3.8-1.3-3.8-1.3-.5-1.3-1.2-1.7-1.2-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 1.7 2.5 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.3-5.1-5.5 0-1.2.4-2.2 1.1-2.9-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 3.1 1.1a10.7 10.7 0 0 1 5.6 0c2.1-1.4 3.1-1.1 3.1-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.7 1.1 2.9 0 4.2-2.6 5.2-5.1 5.5.4.3.8 1 .8 2v3.3c0 .4.2.7.8.6A11.2 11.2 0 0 0 12 .8Z"></path>
          </svg>
          {t.footer.source}
        </md-text-button>
      </li>
    </ul>
  </div>
</footer>

<script>
  import "@material/web/button/text-button.js";
</script>
