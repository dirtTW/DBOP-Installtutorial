---
import { getLocale, getMessages } from "../i18n";

const t = getMessages(getLocale(Astro.props.locale));
---

<footer class="mt-auto border-t border-brand-100 bg-brand-50/70 px-5 py-7 dark:border-brand-900 dark:bg-[#0b293d] sm:px-8">
  <div class="mx-auto flex max-w-screen-xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <span class="text-sm text-zinc-500 dark:text-zinc-400">
    © 2026{" "}
    <a href="https://github.com/yichifauzi" class="hover:underline">
      dirtTW
    </a>
    . {t.footer.rights}
  </span>
  <ul class="flex flex-wrap items-center gap-5 text-sm font-medium text-zinc-600 dark:text-zinc-400">
    <li>
      <a
        href="https://discord.gg/7upZWA82Zk"
        class="transition hover:text-brand-800 hover:underline dark:hover:text-brand-300"
      >
        {t.footer.discord}
      </a>
    </li>
    <li>
      <a
        href="https://github.com/dirttw/DBOP-Installtutorial"
        class="transition hover:text-brand-800 hover:underline dark:hover:text-brand-300"
      >
        {t.footer.source}
      </a>
    </li>
  </ul>
  </div>
</footer>
