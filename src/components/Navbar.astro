---
import { getLocale, getMessages, locales, localizedPath } from "../i18n";
import { Image } from "astro:assets";
import logo from "../img/logo.webp";

const locale = getLocale(Astro.props.locale);
const t = getMessages(locale);
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const pathSegments = pathname.split("/").filter(Boolean);
const route = (
  locales.includes(pathSegments[0] ?? "")
    ? pathSegments.slice(1)
    : pathSegments
).join("/");
const links = [
  { href: "", label: t.nav.home },
  { href: "dbop-install-tutorial", label: t.nav.tutorial },
  { href: "recommended-modpacks", label: t.nav.modpacks },
  { href: "useful-website", label: t.nav.usefulSites },
  { href: "flags-generator", label: t.nav.flags },
];
const prefetchLinks = new Set(["dbop-install-tutorial", "recommended-modpacks"]);
---

<nav
  class="fixed top-0 z-50 w-full border-b border-[var(--md-sys-color-outline-variant)] bg-[var(--md-sys-color-surface)] px-4 backdrop-blur-[14px]"
>
  <div class="relative mx-auto flex min-h-[4.5rem] max-w-screen-xl items-center justify-between gap-3">
    <a
      href={localizedPath(locale, "")}
      class="flex min-w-0 items-center gap-3 rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--md-sys-color-primary)]"
    >
      <Image
        src={logo}
        alt=""
        width={36}
        height={36}
        format="webp"
        loading="eager"
        class="h-9 w-9 rounded-full"
      />
      <span class="truncate text-base font-medium tracking-tight text-[var(--md-sys-color-on-surface)] sm:text-lg">
        dirtTW 土靈
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-1 xl:order-2">
      <md-icon-button
        type="button"
        toggle
        data-theme-toggle
        aria-label={t.theme}
        data-light-label={t.lightTheme}
        data-dark-label={t.darkTheme}
        class="[--md-icon-button-icon-color:var(--md-sys-color-on-surface-variant)]"
      >
        <span class="material-symbols-outlined" aria-hidden="true">light_mode</span>
        <span slot="selected" class="material-symbols-outlined" aria-hidden="true">dark_mode</span>
      </md-icon-button>

      <details class="relative">
        <summary
          aria-label={t.language}
          class="inline-flex min-h-10 cursor-pointer list-none items-center gap-2 rounded-full px-4 text-sm font-medium text-[var(--md-sys-color-on-surface-variant)] transition-colors hover:bg-[var(--md-sys-color-surface-container-high)] hover:text-[var(--md-sys-color-on-surface)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--md-sys-color-primary)]"
        >
          <span>{t.languageName}</span>
          <span class="material-symbols-outlined text-xl" aria-hidden="true">expand_more</span>
        </summary>
        <div
          class="absolute right-0 z-30 mt-2 min-w-40 rounded-2xl bg-[var(--md-sys-color-surface-container-high)] p-1 shadow-lg"
        >
          {locales.map((supportedLocale) => (
            <a
              href={localizedPath(supportedLocale, route)}
              lang={supportedLocale}
              aria-current={supportedLocale === locale ? "true" : undefined}
              class="block rounded-full px-4 py-2.5 text-sm text-[var(--md-sys-color-on-surface)] transition-colors hover:bg-[var(--md-sys-color-surface-container-highest)] aria-[current=true]:bg-[var(--md-sys-color-secondary-container)] aria-[current=true]:font-semibold aria-[current=true]:text-[var(--md-sys-color-on-secondary-container)]"
            >
              {getMessages(supportedLocale).languageName}
            </a>
          ))}
        </div>
      </details>

      <md-icon-button
        type="button"
        data-nav-toggle
        aria-controls="navbar-menu"
        aria-expanded="false"
        aria-label={t.toggleNavigation}
        class="xl:hidden [--md-icon-button-icon-color:var(--md-sys-color-on-surface-variant)]"
      >
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </md-icon-button>
    </div>
    <div
      id="navbar-menu"
      class="absolute right-0 top-full z-20 mt-3 hidden w-[min(21rem,calc(100vw-2rem))] rounded-2xl bg-[var(--md-sys-color-surface-container-high)] p-2.5 shadow-lg xl:order-1 xl:static xl:mt-0 xl:block xl:w-auto xl:shrink-0"
    >
      <ul class="flex flex-col gap-1.5 font-medium xl:flex-row xl:items-center xl:gap-0.5">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={localizedPath(locale, href)}
            data-astro-prefetch={prefetchLinks.has(href) ? "hover" : undefined}
            aria-current={href === route ? "page" : undefined}
            class="group inline-flex min-h-10 items-center justify-between gap-3 rounded-full px-4 text-sm font-medium text-[var(--md-sys-color-on-surface-variant)] transition-colors hover:bg-[var(--md-sys-color-surface-container-highest)] hover:text-[var(--md-sys-color-on-surface)] aria-[current=page]:bg-[var(--md-sys-color-secondary-container)] aria-[current=page]:text-[var(--md-sys-color-on-secondary-container)] xl:px-3.5 xl:text-[13px]"
          >
            {label}
            <span
              aria-hidden="true"
              class="ml-3 h-1.5 w-1.5 rounded-full bg-[var(--md-sys-color-primary)] transition-opacity xl:hidden"
              class:list={[href === route ? "opacity-100" : "opacity-0 group-hover:opacity-60"]}
            ></span>
          </a>
        </li>
      ))}
      </ul>
    </div>
  </div>
</nav>

<script>
  import "@material/web/iconbutton/icon-button.js";
</script>

<style>
  @media (min-width: 1280px) {
    #navbar-menu {
      border-radius: 0;
      background-color: transparent;
      box-shadow: none;
      padding: 0;
    }
  }
</style>
