---
import { getLocale, getMessages, locales, localizedPath } from "../i18n";
import { Image } from "astro:assets";
import logo from "../img/logo.webp";

const locale = getLocale(Astro.props.locale);
const t = getMessages(locale);
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const pathSegments = pathname.split("/").filter(Boolean);
const route = (
  locales.includes(pathSegments[0] ?? "")
    ? pathSegments.slice(1)
    : pathSegments
).join("/");
const links = [
  { href: "", label: t.nav.home },
  { href: "dbop-install-tutorial", label: t.nav.tutorial },
  { href: "recommended-modpacks", label: t.nav.modpacks },
  { href: "minecraft-useful-website", label: t.nav.minecraftSites },
  { href: "useful-website", label: t.nav.usefulSites },
  { href: "flags-generator", label: t.nav.flags },
];
const prefetchLinks = new Set(["dbop-install-tutorial", "recommended-modpacks"]);
---

<nav class="fixed top-0 z-50 w-full border-b border-brand-100/80 bg-[#f7f9ff]/95 px-4 backdrop-blur-xl dark:border-white/10 dark:bg-[#111318]/95">
  <div class="relative mx-auto flex min-h-[4.5rem] max-w-screen-xl items-center justify-between gap-3">
    <a
      href={localizedPath(locale, "")}
      class="flex min-w-0 items-center gap-3 rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600"
    >
      <Image
        src={logo}
        alt=""
        width={36}
        height={36}
        format="webp"
        loading="eager"
        class="h-9 w-9 rounded-full"
      />
      <span class="truncate text-base font-semibold tracking-tight text-zinc-900 dark:text-white sm:text-lg">
        dirtTW 土靈
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-1 xl:order-2">
      <button
        type="button"
        data-theme-toggle
        aria-label={t.theme}
        data-light-label={t.lightTheme}
        data-dark-label={t.darkTheme}
        aria-pressed="false"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-zinc-600 transition-colors hover:bg-brand-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 dark:text-zinc-300 dark:hover:bg-white/10"
      >
        <svg
          class="h-5 w-5 dark:hidden"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
        </svg>
        <svg
          class="hidden h-5 w-5 dark:block"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path>
        </svg>
        <span class="sr-only">{t.theme}</span>
      </button>

      <details class="relative">
        <summary
          aria-label={t.language}
          class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full px-4 text-sm font-medium text-zinc-700 transition-colors hover:bg-brand-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:text-zinc-200 dark:hover:bg-white/10 dark:focus-visible:outline-[#d4e3ff]"
        >
          <span>{t.languageName}</span>
          <svg
            aria-hidden="true"
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M5.22 7.22a.75.75 0 0 1 1.06 0L10 10.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 8.28a.75.75 0 0 1 0-1.06Z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </summary>
        <div class="absolute right-0 z-30 mt-2 min-w-40 rounded-2xl border border-brand-100 bg-[#f7f9ff] p-1 shadow-lg dark:border-white/10 dark:bg-[#252a31]">
          {locales.map((supportedLocale) => (
            <a
              href={localizedPath(supportedLocale, route)}
              lang={supportedLocale}
              aria-current={supportedLocale === locale ? "true" : undefined}
              class:list={[
                "block min-h-11 rounded-full px-4 py-3 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:focus-visible:outline-[#d4e3ff]",
                supportedLocale === locale
                  ? "bg-brand-100 font-semibold text-brand-800 dark:bg-[#33445f] dark:text-[#d4e3ff]"
                  : "text-zinc-700 hover:bg-brand-100 dark:text-zinc-200 dark:hover:bg-white/10",
              ]}
            >
              {getMessages(supportedLocale).languageName}
            </a>
          ))}
        </div>
      </details>

      <button
        type="button"
        data-nav-toggle
        aria-controls="navbar-menu"
        aria-expanded="false"
        aria-label={t.toggleNavigation}
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-zinc-600 transition-colors hover:bg-brand-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 xl:hidden dark:text-zinc-300 dark:hover:bg-white/10"
      >
        <svg
          class="h-5 w-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"
          ></path>
        </svg>
      </button>
    </div>
    <div
      id="navbar-menu"
      class="absolute right-0 top-full z-20 mt-3 hidden w-[min(21rem,calc(100vw-2rem))] rounded-[1.75rem] border border-brand-100 bg-[#f7f9ff] p-2.5 shadow-xl shadow-black/10 xl:order-1 xl:static xl:mt-0 xl:block xl:w-auto xl:shrink-0 xl:rounded-none xl:border-0 xl:bg-transparent xl:p-0 xl:shadow-none dark:border-white/10 dark:bg-[#1c1f25] xl:dark:bg-transparent"
    >
      <ul class="flex flex-col gap-1.5 font-medium xl:flex-row xl:items-center xl:gap-0.5">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={localizedPath(locale, href)}
            data-astro-prefetch={prefetchLinks.has(href) ? "hover" : undefined}
            aria-current={href === route ? "page" : undefined}
            class:list={[
              "group flex min-h-11 items-center justify-between rounded-full px-4 text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 xl:min-h-11 xl:px-3 xl:py-2 xl:text-xs 2xl:px-3.5 2xl:text-sm",
              href === route
                ? "bg-brand-100 text-brand-800 dark:bg-[#33445f] dark:text-[#d4e3ff]"
                : "text-zinc-700 hover:bg-brand-50 hover:text-brand-800 dark:text-zinc-200 dark:hover:bg-white/10 dark:hover:text-white",
            ]}
          >
            {label}
            <span
              aria-hidden="true"
              class:list={[
                "ml-3 h-1.5 w-1.5 rounded-full bg-brand-700 transition-opacity xl:hidden dark:bg-[#d4e3ff]",
                href === route ? "opacity-100" : "opacity-0 group-hover:opacity-60",
              ]}
            ></span>
          </a>
        </li>
      ))}
      </ul>
    </div>
  </div>
</nav>
