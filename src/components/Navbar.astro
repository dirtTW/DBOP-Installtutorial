---
import { getLocale, getMessages, locales, localizedPath } from "../i18n";
import logo from "../img/logo.webp";

const locale = getLocale(Astro.props.locale);
const t = getMessages(locale);
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const pathSegments = pathname.split("/").filter(Boolean);
const route = (
  locales.includes(pathSegments[0] ?? "")
    ? pathSegments.slice(1)
    : pathSegments
).join("/");
const links = [
  { href: "", label: t.nav.home },
  { href: "dbop-install-tutorial", label: t.nav.tutorial },
  { href: "recommended-modpacks", label: t.nav.modpacks },
  { href: "minecraft-useful-website", label: t.nav.minecraftSites },
  { href: "useful-website", label: t.nav.usefulSites },
  { href: "flags-generator", label: t.nav.flags },
];
---

<nav class="fixed top-0 z-50 w-full border-b border-brand-100 bg-white/95 px-4 backdrop-blur dark:border-brand-900 dark:bg-[#0b293d]/95">
  <div class="relative mx-auto flex min-h-16 max-w-screen-xl items-center justify-between gap-3">
    <a
      href={localizedPath(locale, "")}
      class="flex min-w-0 items-center gap-3"
    >
      <img
        src={logo.src}
        class="h-8 w-8"
        alt=""
      />
      <span class="truncate text-base font-semibold text-zinc-900 dark:text-white sm:text-xl">
        dirtTW 土靈
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-1 xl:order-2">
      <button
        type="button"
        data-theme-toggle
        aria-label={t.theme}
        data-light-label={t.lightTheme}
        data-dark-label={t.darkTheme}
        aria-pressed="false"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-zinc-600 hover:bg-brand-50 focus:outline-none focus:ring-2 focus:ring-brand-500 dark:text-zinc-300 dark:hover:bg-brand-900"
      >
        <svg
          class="h-5 w-5 dark:hidden"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
        </svg>
        <svg
          class="hidden h-5 w-5 dark:block"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path>
        </svg>
        <span class="sr-only">{t.theme}</span>
      </button>

      <details class="relative">
        <summary
          aria-label={t.language}
          class="flex h-10 cursor-pointer list-none items-center gap-2 rounded-lg px-3 text-sm font-medium text-zinc-700 hover:bg-brand-50 dark:text-zinc-200 dark:hover:bg-brand-900"
        >
          <span>{t.languageName}</span>
          <svg
            aria-hidden="true"
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M5.22 7.22a.75.75 0 0 1 1.06 0L10 10.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 8.28a.75.75 0 0 1 0-1.06Z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </summary>
        <div class="absolute right-0 z-10 mt-2 min-w-40 rounded-lg border border-brand-100 bg-white p-1 shadow-lg dark:border-brand-900 dark:bg-[#12344c]">
          {locales.map((supportedLocale) => (
            <a
              href={localizedPath(supportedLocale, route)}
              lang={supportedLocale}
              aria-current={supportedLocale === locale ? "true" : undefined}
              class="block rounded px-3 py-2 text-sm text-zinc-700 hover:bg-brand-50 dark:text-zinc-200 dark:hover:bg-brand-900"
            >
              {getMessages(supportedLocale).languageName}
            </a>
          ))}
        </div>
      </details>

      <button
        type="button"
        data-nav-toggle
        aria-controls="navbar-menu"
        aria-expanded="false"
        aria-label={t.toggleNavigation}
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-zinc-600 hover:bg-brand-50 focus:outline-none focus:ring-2 focus:ring-brand-600 xl:hidden dark:text-zinc-300 dark:hover:bg-brand-900"
      >
        <svg
          class="h-5 w-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"
          ></path>
        </svg>
      </button>
    </div>
    <div
      id="navbar-menu"
      class="absolute right-0 top-full hidden w-[min(20rem,calc(100vw-2rem))] rounded-b-xl border border-t-0 border-brand-100 bg-white p-2 shadow-lg xl:order-1 xl:static xl:block xl:w-auto xl:shrink-0 xl:border-0 xl:bg-transparent xl:p-0 xl:shadow-none dark:border-brand-900 dark:bg-[#0b293d] xl:dark:bg-transparent"
    >
      <ul class="flex flex-col gap-1 font-medium xl:flex-row xl:items-center xl:gap-0.5">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={localizedPath(locale, href)}
            class="block rounded-lg px-3 py-2 text-sm text-zinc-700 transition hover:bg-brand-50 hover:text-brand-800 xl:px-2 xl:text-xs 2xl:px-3 2xl:text-sm dark:text-zinc-200 dark:hover:bg-brand-900 dark:hover:text-brand-200"
          >
            {label}
          </a>
        </li>
      ))}
      </ul>
    </div>
  </div>
</nav>
