---
import { getLocale, getMessages, locales, localizedPath } from "../i18n";
import { Image } from "astro:assets";
import logo from "../img/logo.webp";

const locale = getLocale(Astro.props.locale);
const t = getMessages(locale);
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const pathSegments = pathname.split("/").filter(Boolean);
const route = (
  locales.includes(pathSegments[0] ?? "")
    ? pathSegments.slice(1)
    : pathSegments
).join("/");
const links = [
  { href: "", label: t.nav.home },
  { href: "dbop-install-tutorial", label: t.nav.tutorial },
  { href: "recommended-modpacks", label: t.nav.modpacks },
  { href: "useful-website", label: t.nav.usefulSites },
  { href: "flags-generator", label: t.nav.flags },
];
const prefetchLinks = new Set(["dbop-install-tutorial", "recommended-modpacks"]);
---

<nav class="md3-appbar fixed top-0 z-50 w-full px-4">
  <div class="relative mx-auto flex min-h-[4.5rem] max-w-screen-xl items-center justify-between gap-3">
    <a
      href={localizedPath(locale, "")}
      class="flex min-w-0 items-center gap-3 rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--m3-primary)]"
    >
      <Image
        src={logo}
        alt=""
        width={36}
        height={36}
        format="webp"
        loading="eager"
        class="h-9 w-9 rounded-full"
      />
      <span class="truncate text-base font-medium tracking-tight text-[var(--m3-on-surface)] sm:text-lg">
        dirtTW 土靈
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-1 xl:order-2">
      <button
        type="button"
        data-theme-toggle
        aria-label={t.theme}
        data-light-label={t.lightTheme}
        data-dark-label={t.darkTheme}
        aria-pressed="false"
        class="md3-icon-button"
      >
        <svg
          class="h-5 w-5 dark:hidden"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
        </svg>
        <svg
          class="hidden h-5 w-5 dark:block"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path>
        </svg>
        <span class="sr-only">{t.theme}</span>
      </button>

      <details class="relative">
        <summary
          aria-label={t.language}
          class="md3-nav-link cursor-pointer list-none focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--m3-primary)]"
        >
          <span>{t.languageName}</span>
          <svg
            aria-hidden="true"
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M5.22 7.22a.75.75 0 0 1 1.06 0L10 10.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 8.28a.75.75 0 0 1 0-1.06Z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </summary>
        <div class="md3-menu absolute right-0 z-30 mt-2 min-w-40">
          {locales.map((supportedLocale) => (
            <a
              href={localizedPath(supportedLocale, route)}
              lang={supportedLocale}
              aria-current={supportedLocale === locale ? "true" : undefined}
              class="md3-menu-item"
            >
              {getMessages(supportedLocale).languageName}
            </a>
          ))}
        </div>
      </details>

      <button
        type="button"
        data-nav-toggle
        aria-controls="navbar-menu"
        aria-expanded="false"
        aria-label={t.toggleNavigation}
        class="md3-icon-button xl:hidden"
      >
        <svg
          class="h-5 w-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"
          ></path>
        </svg>
      </button>
    </div>
    <div
      id="navbar-menu"
      class="md3-menu absolute right-0 top-full z-20 mt-3 hidden w-[min(21rem,calc(100vw-2rem))] p-2.5 xl:order-1 xl:static xl:mt-0 xl:block xl:w-auto xl:shrink-0"
    >
      <ul class="flex flex-col gap-1.5 font-medium xl:flex-row xl:items-center xl:gap-0.5">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={localizedPath(locale, href)}
            data-astro-prefetch={prefetchLinks.has(href) ? "hover" : undefined}
            aria-current={href === route ? "page" : undefined}
            class="md3-nav-link group"
          >
            {label}
            <span
              aria-hidden="true"
              class="ml-3 h-1.5 w-1.5 rounded-full bg-[var(--m3-primary)] transition-opacity xl:hidden"
              class:list={[href === route ? "opacity-100" : "opacity-0 group-hover:opacity-60"]}
            ></span>
          </a>
        </li>
      ))}
      </ul>
    </div>
  </div>
</nav>

<style>
  #navbar-menu {
    padding: 0.625rem;
  }

  @media (min-width: 1280px) {
    #navbar-menu {
      border-radius: 0;
      background-color: transparent;
      box-shadow: none;
      padding: 0;
    }

    #navbar-menu .md3-nav-link {
      padding: 0 0.875rem;
      font-size: 0.8125rem;
    }
  }
</style>
