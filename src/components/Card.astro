---
import { getLocale, getMessages } from "../i18n";
import fallbackImage from "../img/logo.webp";

interface Props {
  modrinthId?: string;
  name?: string;
  altText?: string;
  locale?: string;
  modrinthlink?: string;
  curseforgelink?: string;
  imageUrl?: string;
  fallbackVersion?: string;
  fetchMetadata?: boolean;
}

const {
  modrinthId,
  name,
  altText,
  modrinthlink,
  curseforgelink,
  imageUrl,
  fallbackVersion,
  fetchMetadata = false,
} = Astro.props;
const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);

let version = fallbackVersion || t.cards.unknownVersion;
let gameVersions: string[] = [];
let imagePath = imageUrl || fallbackImage.src;
let displayName = name || t.modpacks.unknownRecommendedName;
let description = altText || t.modpacks.recommendedDescription;

if (Astro.site) {
  if (modrinthId) {
    try {
      const projectData = await fetch(
        `https://api.modrinth.com/v2/project/${modrinthId}`,
      ).then((res) => res.json());
      const versionData = await fetch(
        `https://api.modrinth.com/v2/project/${modrinthId}/version`,
      ).then((res) => res.json());

      version = versionData?.[0]?.version_number || version;
      gameVersions = versionData?.[0]?.game_versions || [];
      imagePath = projectData?.icon_url || imagePath;
      if (fetchMetadata) {
        displayName = projectData?.title || displayName;
        description = projectData?.description || description;
      }
    } catch (error) {
      console.error("Error fetching data from Modrinth API:", error);
    }
  }
}

const isModrinthLinkValid = !!modrinthlink;
const isCurseforgeLinkValid = !!curseforgelink;
const downloadCount = Number(isModrinthLinkValid) + Number(isCurseforgeLinkValid);
---

<article class="m3-modpack">
  <img
    class="m3-modpack-avatar"
    src={imagePath}
    data-fallback-src={fallbackImage.src}
    alt={`${displayName} ${locale === "en" ? "image" : "圖片"}`}
    loading="lazy"
  />
  <div class="m3-modpack-body">
    <h2 class="m3-modpack-name">{displayName}</h2>
    <p class="m3-modpack-desc">{description}</p>
    <div class="m3-modpack-meta">
      <span class="m3-chip">
        {t.cards.version} <strong>{version}</strong>
      </span>
      {gameVersions.length > 0 && (
        <span class="m3-chip">
          {t.cards.supportedVersions} <strong>{gameVersions.join(", ")}</strong>
        </span>
      )}
    </div>
  </div>
  <div
    class:list={[
      "m3-modpack-actions",
      downloadCount > 1 && "m3-modpack-actions--multi",
    ]}
  >
    {isModrinthLinkValid && (
      <a class="m3-download m3-download--modrinth" href={modrinthlink}>
        <i class="md-logo" aria-hidden="true" />
        {t.cards.downloadModrinthShort}
      </a>
    )}
    {isCurseforgeLinkValid && (
      <a class="m3-download m3-download--curseforge" href={curseforgelink}>
        <i class="cf-logo" aria-hidden="true" />
        {t.cards.downloadCurseforgeShort}
      </a>
    )}
  </div>
</article>

<style>
  .m3-modpack {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
    padding: 0.875rem;
    border-radius: 1.5rem;
    background-color: var(--m3-item-surface);
    transition: background-color 180ms var(--m3-easing);
  }

  .m3-modpack:hover {
    background-color: color-mix(
      in srgb,
      var(--m3-on-surface) 4%,
      var(--m3-item-surface)
    );
  }

  .m3-modpack-avatar {
    grid-column: 1;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background-color: var(--m3-surface-container-high);
    object-fit: cover;
  }

  .m3-modpack-body {
    grid-column: 2;
    min-width: 0;
  }

  .m3-modpack-name {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5rem;
    color: var(--m3-on-surface);
    overflow-wrap: anywhere;
  }

  .m3-modpack-desc {
    margin-top: 0.125rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--m3-on-surface-variant);
  }

  .m3-modpack-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.625rem;
  }

  .m3-chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0 0.625rem;
    border: 1px solid var(--m3-outline-variant);
    border-radius: 0.5rem;
    color: var(--m3-on-surface-variant);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1rem;
  }

  .m3-chip strong {
    margin-left: 0.25rem;
    color: var(--m3-on-surface);
    font-weight: 600;
  }

  .m3-modpack-actions {
    display: grid;
    grid-column: 1 / -1;
    gap: 0.5rem;
  }

  .m3-modpack-actions--multi {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .m3-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1rem;
    text-align: center;
    transition:
      background-color 180ms var(--m3-easing),
      box-shadow 180ms var(--m3-easing);
  }

  .m3-download:hover {
    box-shadow:
      0 1px 3px 1px rgb(0 0 0 / 0.15),
      0 1px 2px rgb(0 0 0 / 0.3);
  }

  .m3-download:focus-visible {
    outline: 3px solid var(--m3-primary);
    outline-offset: 2px;
  }

  .m3-download--modrinth {
    background-color: #1bd96a;
    color: #102217;
  }

  .m3-download--modrinth:hover {
    background-color: #16c45d;
  }

  .m3-download--curseforge {
    background-color: #f16436;
    color: #ffffff;
  }

  .m3-download--curseforge:hover {
    background-color: #db5128;
  }

  @media (min-width: 640px) {
    .m3-modpack {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 1rem;
      padding: 1.125rem;
    }

    .m3-modpack-avatar {
      width: 4.5rem;
      height: 4.5rem;
    }

    .m3-download {
      min-height: 2.5rem;
      padding: 0 1.25rem;
      font-size: 0.875rem;
      line-height: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .m3-modpack {
      grid-template-columns: 5.5rem minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 1.5rem;
    }

    .m3-modpack-avatar {
      width: 5.5rem;
      height: 5.5rem;
    }

    .m3-modpack-actions {
      grid-column: 3;
      display: flex;
      flex-direction: column;
    }
  }
</style>

  <script>
    document.querySelectorAll<HTMLImageElement>("[data-fallback-src]").forEach((image) => {
      image.addEventListener(
        "error",
        () => {
          const fallback = image.dataset.fallbackSrc;
          if (fallback) {
            delete image.dataset.fallbackSrc;
            image.src = fallback;
          }
        },
        { once: true },
      );
    });
  </script>
