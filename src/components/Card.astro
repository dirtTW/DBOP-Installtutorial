---
import { getLocale, getMessages } from "../i18n";
import fallbackImage from "../img/logo.webp";

interface Props {
  modrinthId: string;
  name: string;
  altText: string;
  locale?: string;
  modrinthlink?: string;
  curseforgelink?: string;
  imageUrl?: string;
  fallbackVersion?: string;
}

const {
  modrinthId,
  name,
  altText,
  modrinthlink,
  curseforgelink,
  imageUrl,
  fallbackVersion,
} = Astro.props;
const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);

let version = fallbackVersion || t.cards.unknownVersion;
let gameVersions: string[] = [];
let imagePath = imageUrl || "/placeholder-image.jpg";

if (Astro.site) {
  // Running at build time (static generation)
  if (modrinthId) {
    try {
      const projectData = await fetch(
        `https://api.modrinth.com/v2/project/${modrinthId}`,
      ).then((res) => res.json());
      const versionData = await fetch(
        `https://api.modrinth.com/v2/project/${modrinthId}/version`,
      ).then((res) => res.json());

      version = versionData?.[0]?.version_number || version;
      gameVersions = versionData?.[0]?.game_versions || [];
      imagePath = projectData?.icon_url || imagePath;
    } catch (error) {
      console.error("Error fetching data from Modrinth API:", error);
    }
  }
}

const isModrinthLinkValid = !!modrinthlink;
const isCurseforgeLinkValid = !!curseforgelink;
const downloadButtonClass =
  "inline-flex min-h-12 min-w-0 flex-col items-center justify-center gap-1 rounded-xl px-2 py-2 text-center text-[11px] font-semibold leading-tight text-white shadow-sm transition hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 sm:min-h-10 sm:flex-row sm:gap-0 sm:whitespace-nowrap sm:px-3.5 sm:text-xs sm:leading-normal dark:focus-visible:ring-offset-[#0b293d]";
---

<article class="grid grid-cols-[3.5rem_minmax(0,1fr)] items-start gap-3 rounded-2xl border border-brand-100 bg-white p-3 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-950/5 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-5 sm:p-4 dark:border-brand-900 dark:bg-[#0b293d] dark:hover:border-brand-700">
  <img
    class="row-span-2 h-14 w-14 rounded-xl border border-brand-100 bg-brand-50/60 object-cover shadow-sm sm:h-32 sm:w-32 dark:border-brand-800 dark:bg-[#071d2d]"
    src={imagePath}
    data-fallback-src={fallbackImage.src}
    alt={altText || `${name} ${locale === "en" ? "image" : "圖片"}`}
    loading="lazy"
  />
  <h2 class="min-w-0 py-1 text-sm font-bold leading-5 tracking-tight text-brand-950 sm:py-2 sm:text-xl sm:leading-tight dark:text-white">
      {name}
  </h2>
  <p class="col-span-full text-sm leading-5 text-zinc-600 sm:col-span-1 sm:col-start-2 sm:row-start-2 sm:leading-6 dark:text-zinc-400">{altText}</p>
  <p class="col-span-full inline-flex flex-wrap items-center gap-x-1.5 gap-y-1 rounded-lg bg-brand-50 px-2.5 py-1.5 text-xs font-medium text-brand-700 sm:col-start-2 sm:row-start-3 dark:bg-brand-950/60 dark:text-brand-300">
    {t.cards.version} <span class="font-semibold text-brand-950 dark:text-brand-100">{version}</span>
    {gameVersions.length > 0
      ? ` · ${t.cards.supportedVersions} ${gameVersions.join(", ")}`
      : ""}
  </p>
  <div class="col-span-full grid grid-cols-2 gap-2 sm:flex sm:col-span-full sm:flex-wrap">
      <a
        class={`${downloadButtonClass} bg-brand-600 hover:bg-brand-500 dark:bg-brand-400 dark:text-brand-950 dark:hover:bg-brand-300 ${!isModrinthLinkValid ? "pointer-events-none cursor-not-allowed opacity-50" : ""}`}
        href={isModrinthLinkValid ? modrinthlink : undefined}
        aria-disabled={!isModrinthLinkValid}
        tabindex={isModrinthLinkValid ? 0 : -1}
      >
        <i class="md-logo sm:me-2" aria-hidden="true" />
        {t.cards.downloadModrinthShort}
      </a>
      <a
        class={`${downloadButtonClass} border border-brand-800 bg-brand-950 hover:bg-brand-900 dark:border-brand-700 dark:bg-brand-800 dark:hover:bg-brand-700 ${!isCurseforgeLinkValid ? "pointer-events-none cursor-not-allowed opacity-50" : ""}`}
        href={isCurseforgeLinkValid ? curseforgelink : undefined}
        aria-disabled={!isCurseforgeLinkValid}
        tabindex={isCurseforgeLinkValid ? 0 : -1}
      >
        <i class="cf-logo sm:me-2" aria-hidden="true" />
        {t.cards.downloadCurseforgeShort}
      </a>
  </div>
</article>

  <script>
    document.querySelectorAll<HTMLImageElement>("[data-fallback-src]").forEach((image) => {
      image.addEventListener(
        "error",
        () => {
          const fallback = image.dataset.fallbackSrc;
          if (fallback) {
            delete image.dataset.fallbackSrc;
            image.src = fallback;
          }
        },
        { once: true },
      );
    });
  </script>
