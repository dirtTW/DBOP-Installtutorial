---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mx-auto max-w-screen-xl px-5 pb-8 pt-28 sm:px-8 sm:pb-10 lg:px-10">
  <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-brand-700 dark:text-brand-400">
    {eyebrow}
  </p>
  <h1 class="max-w-3xl text-m3-headline-small font-semibold tracking-tight text-zinc-950 sm:text-m3-headline-medium dark:text-white">
    {title}
  </h1>
  <p class="mt-4 max-w-2xl text-base leading-7 text-m3-on-surface-variant sm:text-lg">
    {description}
  </p>
</header>
