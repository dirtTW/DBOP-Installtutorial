---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mx-auto max-w-screen-xl px-5 pb-8 pt-28 sm:px-8 sm:pb-10 lg:px-10">
  <p class="md3-eyebrow mb-3">{eyebrow}</p>
  <h1 class="md3-headline page-title max-w-3xl">{title}</h1>
  <p class="md3-body mt-4 max-w-2xl">{description}</p>
</header>

<style>
  .page-title {
    font-size: 2rem;
    line-height: 2.5rem;
  }

  @media (min-width: 640px) {
    .page-title {
      font-size: 2.5rem;
      line-height: 3rem;
    }
  }
</style>
