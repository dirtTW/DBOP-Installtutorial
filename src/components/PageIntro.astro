---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mx-auto max-w-screen-xl px-5 pb-8 pt-28 sm:px-8 sm:pb-10 lg:px-10">
  <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-400">
    {eyebrow}
  </p>
  <h1 class="max-w-3xl text-3xl font-black tracking-tight text-zinc-950 sm:text-4xl dark:text-white">
    {title}
  </h1>
  <p class="mt-4 max-w-2xl text-base leading-7 text-zinc-600 sm:text-lg dark:text-zinc-400">
    {description}
  </p>
</header>
