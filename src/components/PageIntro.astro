---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mx-auto max-w-screen-xl px-5 pb-8 pt-28 sm:px-8 sm:pb-10 lg:px-10">
  <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--md-sys-color-primary)]">
    {eyebrow}
  </p>
  <h1 class="max-w-3xl text-[clamp(2rem,4vw,2.5rem)] font-medium leading-[1.15] tracking-[-0.01em]">
    {title}
  </h1>
  <p class="mt-4 max-w-2xl text-base leading-6 text-[var(--md-sys-color-on-surface-variant)]">
    {description}
  </p>
</header>
