---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageIntro from "./PageIntro.astro";
import "../styles/global.css";
import { getLocale, getMessages } from "../i18n";

interface Props {
  locale?: string;
}

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);

type PresetOption = {
  id: string;
  label: string;
  description: string;
  href?: string;
};

const presetOptions: PresetOption[] = [
  {
    id: "basic",
    label: t.flags.presets.basic.name,
    description: t.flags.presets.basic.description,
  },
  {
    id: "aikars",
    label: t.flags.presets.aikars.name,
    description: t.flags.presets.aikars.description,
    href: "https://docs.papermc.io/paper/aikars-flags/",
  },
  {
    id: "zgc",
    label: t.flags.presets.zgc.name,
    description: t.flags.presets.zgc.description,
    href: "https://obydux.github.io/Minecraft-startup-flags/",
  },
  {
    id: "shenandoah",
    label: t.flags.presets.shenandoah.name,
    description: t.flags.presets.shenandoah.description,
    href: "https://github.com/brucethemoose/Minecraft-Performance-Flags-Benchmarks",
  },
  {
    id: "velocity",
    label: t.flags.presets.velocity.name,
    description: t.flags.presets.velocity.description,
    href: "https://docs.papermc.io/velocity/getting-started/",
  },
];
---

<Layout title={t.flags.title} locale={locale}>
  <Navbar locale={locale} />
  <main
    id="generator"
    class="pb-12"
    data-filename-error={t.flags.filenameError}
    data-restart-warning={t.flags.javaRestartWarning}
    data-copied={t.flags.copied}
    data-clipboard-error={t.flags.clipboardError}
    data-downloaded-template={t.flags.downloaded("__filename__")}
  >
    <PageIntro eyebrow={t.flags.eyebrow} title={t.flags.title} description={t.flags.description} />
    <section class="mx-auto max-w-4xl px-5 sm:px-8 lg:px-0">
      <div class="surface-card grid gap-5 p-4 sm:gap-6 sm:p-6 md:grid-cols-2">
        <div>
          <label
            for="server-file"
            class="mb-2 block text-sm font-medium leading-5 text-[var(--md-sys-color-on-surface)]"
          >
            {t.flags.serverFile}
          </label>
          <md-outlined-text-field
            id="server-file"
            class="w-full"
            value="server.jar"
            pattern="[A-Za-z0-9][A-Za-z0-9._-]*\.jar"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="filename-help"
          ></md-outlined-text-field>
          <p id="filename-help" class="mt-2 text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)]">
            {t.flags.filenameHelp}
          </p>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="block text-sm font-medium leading-5 text-[var(--md-sys-color-on-surface)]">
              {t.flags.memory}
            </span>
            <div class="flex items-center gap-2">
              <output
                id="memory-value"
                for="memory"
                class="text-sm font-medium leading-5 text-[var(--md-sys-color-on-surface)]"
              >4 GB</output>
              <md-icon-button
                id="custom-memory-open"
                type="button"
                aria-label={t.flags.advancedMemory}
                aria-haspopup="dialog"
                class="[--md-icon-button-icon-color:var(--md-sys-color-on-surface-variant)]"
              >
                <span class="material-symbols-outlined" aria-hidden="true">tune</span>
              </md-icon-button>
            </div>
          </div>
          <md-slider
            id="memory"
            class="mt-2 w-full"
            min="1"
            max="32"
            step="0.25"
            value="4"
            aria-label={t.flags.memory}
          ></md-slider>
          <div class="relative mt-2 h-5">
            { [4, 8, 12, 16, 20, 24, 28, 32].map((size) => (
              <button
                type="button"
                class="memory-preset absolute -translate-x-1/2 whitespace-nowrap text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)] transition-colors hover:text-[var(--md-sys-color-primary)] focus-visible:text-[var(--md-sys-color-primary)] focus-visible:outline-none"
                data-memory={size}
                aria-label={t.flags.setMemory(size)}
                style={`left: calc(8px + (100% - 16px) * ${(size - 1) / 31})`}
              >
                {size} GB
              </button>
            )) }
          </div>
          <p class="mt-2 text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)]">
            {t.flags.memoryHelp}
          </p>
        </div>

        <div class="option-row flex items-center gap-3 rounded-2xl bg-[var(--md-sys-color-surface-container-high)] p-4 transition-colors hover:bg-[var(--md-sys-color-surface-container-highest)]">
          <div class="min-w-0 flex-1">
            <label
              for="enable-gui"
              class="block text-sm font-medium leading-5 text-[var(--md-sys-color-on-surface)]"
            >{t.flags.enableGui}</label>
            <p class="mt-1 text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)]">
              {t.flags.guiHelp}
            </p>
          </div>
          <md-switch id="enable-gui" aria-label={t.flags.enableGui}></md-switch>
        </div>

        <div class="option-row flex items-center gap-3 rounded-2xl bg-[var(--md-sys-color-surface-container-high)] p-4 transition-colors hover:bg-[var(--md-sys-color-surface-container-highest)]">
          <div class="min-w-0 flex-1">
            <label
              for="auto-restart"
              class="block text-sm font-medium leading-5 text-[var(--md-sys-color-on-surface)]"
            >{t.flags.autoRestart}</label>
            <p class="mt-1 text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)]">
              {t.flags.restartHelp}
            </p>
          </div>
          <md-switch id="auto-restart" aria-label={t.flags.autoRestart}></md-switch>
        </div>

        <div
          id="ignore-java-option"
          class="option-row flex items-center gap-3 rounded-2xl bg-[var(--md-sys-color-surface-container-high)] p-4 transition-colors hover:bg-[var(--md-sys-color-surface-container-highest)] md:col-span-2"
        >
          <div class="min-w-0 flex-1">
            <label
              for="ignore-java-version"
              class="block text-sm font-medium leading-5 text-[var(--md-sys-color-on-surface)]"
            >{t.flags.ignoreJavaVersion}</label>
            <p class="mt-1 text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)]">
              {t.flags.ignoreJavaVersionHelp}
            </p>
          </div>
          <md-switch id="ignore-java-version" aria-label={t.flags.ignoreJavaVersion}></md-switch>
        </div>
      </div>

      <section class="surface-card mt-5 p-4 sm:mt-6 sm:p-6">
        <div>
          <h2 class="text-base font-medium leading-6">
            {t.flags.presetHeading}
          </h2>
          <p class="mt-1 text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)]">
            {t.flags.presetHelp}
          </p>
        </div>
        <ul
          class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5"
          aria-label={t.flags.presetHeading}
        >
          {presetOptions.map((option) => (
            <li class="flex flex-col">
              <md-filter-chip
                class="preset-option self-start [--md-filter-chip-container-height:2.5rem]"
                selected={option.id === "aikars"}
                data-preset={option.id}
              >
                {option.label}
              </md-filter-chip>
              <p class="mt-2 text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)]">
                {option.description}
                {option.href && (
                  <>
                    {" "}
                    <a
                      class="whitespace-nowrap font-medium text-[var(--md-sys-color-primary)] hover:underline"
                      href={option.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {t.flags.learnMore}
                    </a>
                  </>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section class="surface-card mt-6 overflow-hidden sm:mt-8">
        <div class="flex flex-col gap-2 p-2 sm:flex-row sm:items-center sm:justify-between sm:p-3">
          <md-tabs class="min-w-0" aria-label={t.flags.outputFormat}>
            <md-primary-tab data-platform="unix" class="text-xs sm:text-sm">
              Linux / macOS
            </md-primary-tab>
            <md-primary-tab data-platform="windows" class="text-xs sm:text-sm">
              Windows
            </md-primary-tab>
            <md-primary-tab data-platform="java" class="text-xs sm:text-sm">
              {t.flags.javaCommand}
            </md-primary-tab>
          </md-tabs>
          <div class="flex gap-2 px-1 pb-1 sm:shrink-0 sm:px-0 sm:pb-0">
            <md-outlined-button
              id="copy-script"
              type="button"
              class="flex-1 sm:flex-none [--md-outlined-button-container-height:2.75rem]"
            >
              {t.flags.copy}
            </md-outlined-button>
            <md-filled-button
              id="download-script"
              type="button"
              class="flex-1 sm:flex-none [--md-filled-button-container-height:2.75rem]"
            >
              {t.flags.download}
            </md-filled-button>
          </div>
        </div>
        <pre class="min-h-48 overflow-x-auto bg-[var(--code-surface)] p-4 font-mono text-xs leading-6 text-[var(--code-text)] sm:p-5 sm:text-sm"><code id="script-output"></code></pre>
        <p
          id="generator-status"
          class="min-h-10 px-4 py-3 text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)]"
          aria-live="polite"
        ></p>
      </section>

      <p class="mt-6 text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)]">
        {t.flags.attributionStart}
        <a
          class="font-medium text-[var(--md-sys-color-primary)] hover:underline"
          href="https://flags.sh/"
          target="_blank"
          rel="noopener noreferrer"
        >flags.sh</a>
        {t.flags.attributionBy}
        <a
          class="font-medium text-[var(--md-sys-color-primary)] hover:underline"
          href="https://github.com/YouHaveTrouble/flags.sh"
          target="_blank"
          rel="noopener noreferrer"
        >YouHaveTrouble</a>
        {t.flags.attributionEnd}
      </p>
      <p class="mt-2 text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)]">
        {t.flags.presetAttributionStart}
        <a
          class="font-medium text-[var(--md-sys-color-primary)] hover:underline"
          href="https://flectone.net/en/tools/server-flags-generator"
          target="_blank"
          rel="noopener noreferrer"
        >{t.flags.presetAttributionLink}</a>
        {t.flags.presetAttributionEnd}
      </p>
    </section>
    <md-dialog id="custom-memory-dialog">
      <div slot="headline" class="px-6 pt-6 text-2xl leading-8">
        {t.flags.advancedOptions}
      </div>
      <div slot="content" class="flex flex-col gap-2 px-6 pb-2 pt-4">
        <label
          for="custom-memory"
          class="block text-sm font-medium leading-5 text-[var(--md-sys-color-on-surface)]"
        >
          {t.flags.customMemory}
        </label>
        <md-outlined-text-field
          id="custom-memory"
          type="number"
          min="1"
          max="32"
          step="0.25"
          value="4.00"
          required
          autofocus
          inputmode="decimal"
        ></md-outlined-text-field>
        <p class="text-xs leading-4 text-[var(--md-sys-color-on-surface-variant)]">
          {t.flags.customMemoryHelp}
        </p>
      </div>
      <div slot="actions" class="flex justify-end gap-2 px-6 pb-6 pt-4">
        <md-text-button id="custom-memory-cancel" type="button">
          {t.flags.cancel}
        </md-text-button>
        <md-filled-button id="custom-memory-apply" type="button">
          {t.flags.apply}
        </md-filled-button>
      </div>
    </md-dialog>
  </main>
  <Footer locale={locale} />
</Layout>

<script>
  import "@material/web/textfield/outlined-text-field.js";
  import "@material/web/button/filled-button.js";
  import "@material/web/button/outlined-button.js";
  import "@material/web/button/text-button.js";
  import "@material/web/chips/filter-chip.js";
  import "@material/web/dialog/dialog.js";
  import "@material/web/iconbutton/icon-button.js";
  import "@material/web/slider/slider.js";
  import "@material/web/switch/switch.js";
  import "@material/web/tabs/tabs.js";
  import "@material/web/tabs/primary-tab.js";

  type Platform = "unix" | "windows" | "java";
  type PresetId = "basic" | "aikars" | "zgc" | "shenandoah" | "velocity";

  type TextFieldElement = HTMLElement & {
    value: string;
    reportValidity(): boolean;
    focus(): void;
  };
  type SliderElement = HTMLElement & { value: number; valueLabel: string };
  type SwitchElement = HTMLElement & { selected: boolean; disabled: boolean };
  type ChipElement = HTMLElement & { selected: boolean };
  type DialogElement = HTMLElement & {
    show(): Promise<void> | void;
    close(returnValue?: string): Promise<void> | void;
  };
  type TabsElement = HTMLElement & {
    activeTab: (HTMLElement & { dataset: DOMStringMap }) | null;
  };

  const fileInput = document.querySelector<TextFieldElement>("#server-file");
  const memoryInput = document.querySelector<SliderElement>("#memory");
  const memoryValue = document.querySelector<HTMLOutputElement>("#memory-value");
  const memoryDialog = document.querySelector<DialogElement>("#custom-memory-dialog");
  const customMemoryInput = document.querySelector<TextFieldElement>("#custom-memory");
  const openMemoryDialogButton = document.querySelector<HTMLElement>("#custom-memory-open");
  const cancelMemoryDialogButton = document.querySelector<HTMLElement>("#custom-memory-cancel");
  const applyMemoryButton = document.querySelector<HTMLElement>("#custom-memory-apply");
  const guiSwitch = document.querySelector<SwitchElement>("#enable-gui");
  const restartSwitch = document.querySelector<SwitchElement>("#auto-restart");
  const ignoreJavaVersionSwitch =
    document.querySelector<SwitchElement>("#ignore-java-version");
  const presetButtons = document.querySelectorAll<ChipElement>(".preset-option");
  const output = document.querySelector<HTMLElement>("#script-output");
  const status = document.querySelector<HTMLElement>("#generator-status");
  const copyButton = document.querySelector<HTMLElement>("#copy-script");
  const downloadButton = document.querySelector<HTMLElement>("#download-script");
  const tabs = document.querySelector<TabsElement>("md-tabs");
  const generator = document.querySelector<HTMLElement>("#generator");

  let platform: Platform = "unix";
  let preset: PresetId = "aikars";

  function isPresetId(value: string | undefined): value is PresetId {
    return (
      value === "basic" ||
      value === "aikars" ||
      value === "zgc" ||
      value === "shenandoah" ||
      value === "velocity"
    );
  }

  function buildFlags(memoryGb: number): string[] {
    const memory = Math.round(memoryGb * 1024);
    const heap = [`-Xms${memory}M`, `-Xmx${memory}M`];
    const vectorModule = "--add-modules=jdk.incubator.vector";
    const ignoreJavaVersion = ignoreJavaVersionSwitch?.selected
      ? ["-Dpaper.ignoreJavaVersion=true"]
      : [];

    switch (preset) {
      case "basic":
        return [...heap, vectorModule, ...ignoreJavaVersion];
      case "zgc":
        return [
          ...heap,
          vectorModule,
          "-XX:+UseZGC",
          "-XX:+ZGenerational",
          "-XX:+AlwaysPreTouch",
          "-XX:+UseStringDeduplication",
          "-XX:TrimNativeHeapInterval=5000",
          ...ignoreJavaVersion,
        ];
      case "shenandoah":
        return [
          ...heap,
          vectorModule,
          "-XX:+UseShenandoahGC",
          "-XX:ShenandoahGCMode=iu",
          "-XX:ShenandoahGuaranteedGCInterval=1000000",
          "-XX:+AlwaysPreTouch",
          "-XX:+DisableExplicitGC",
          "-XX:AllocatePrefetchStyle=1",
          ...ignoreJavaVersion,
        ];
      case "velocity":
        return [
          ...heap,
          "-XX:+UseG1GC",
          "-XX:G1HeapRegionSize=4M",
          "-XX:+UnlockExperimentalVMOptions",
          "-XX:+ParallelRefProcEnabled",
          "-XX:+AlwaysPreTouch",
          "-XX:MaxInlineLevel=15",
        ];
      case "aikars": {
        const largeHeap = Math.floor(memoryGb) >= 12;
        return [
          ...heap,
          vectorModule,
          "-XX:+UseG1GC",
          "-XX:+ParallelRefProcEnabled",
          "-XX:MaxGCPauseMillis=200",
          "-XX:+UnlockExperimentalVMOptions",
          "-XX:+DisableExplicitGC",
          "-XX:+AlwaysPreTouch",
          `-XX:G1NewSizePercent=${largeHeap ? 40 : 30}`,
          `-XX:G1MaxNewSizePercent=${largeHeap ? 50 : 40}`,
          `-XX:G1HeapRegionSize=${largeHeap ? 16 : 8}M`,
          `-XX:G1ReservePercent=${largeHeap ? 15 : 20}`,
          "-XX:G1HeapWastePercent=5",
          "-XX:G1MixedGCCountTarget=4",
          "-XX:InitiatingHeapOccupancyPercent=15",
          "-XX:G1MixedGCLiveThresholdPercent=90",
          "-XX:G1RSetUpdatingPauseTimePercent=5",
          "-XX:SurvivorRatio=32",
          "-XX:+PerfDisableSharedMem",
          "-XX:MaxTenuringThreshold=1",
          "-Dusing.aikars.flags=https://mcflags.emc.gs",
          "-Daikars.new.flags=true",
          ...ignoreJavaVersion,
        ];
      }
    }
  }

  function syncPresetOptions() {
    const isProxy = preset === "velocity";
    const isBasic = preset === "basic";

    if (guiSwitch) {
      // Click instead of assigning `selected` so the switch's internal input
      // stays in sync (it only tracks the `checked` attribute on first render).
      if (isProxy && guiSwitch.selected) guiSwitch.click();
      guiSwitch.disabled = isProxy;
    }

    if (ignoreJavaVersionSwitch) {
      if ((isBasic || isProxy) && ignoreJavaVersionSwitch.selected) {
        ignoreJavaVersionSwitch.click();
      }
      ignoreJavaVersionSwitch.disabled = isBasic || isProxy;
    }
  }

  function getGeneratedScript(): string | null {
    if (!fileInput || !memoryInput || !guiSwitch || !restartSwitch) return null;

    const filename = fileInput.value.trim();
    if (!/^[A-Za-z0-9][A-Za-z0-9._-]*\.jar$/i.test(filename)) {
      if (status) {
        status.textContent = generator?.dataset.filenameError ?? "";
      }
      return null;
    }

    const memory = Number(memoryInput.value);
    const flags = buildFlags(memory).join(" ");
    const serverOptions = preset === "velocity" || guiSwitch.selected ? "" : " --nogui";
    const javaCommand = `java ${flags} -jar "${filename}"${serverOptions}`;

    if (platform === "windows") {
      if (!restartSwitch.selected) return `@echo off\r\ncd /d "%~dp0"\r\n${javaCommand}\r\n`;
      return `@echo off\r\ncd /d "%~dp0"\r\n:run\r\n${javaCommand}\r\ntimeout /t 5 /nobreak >nul\r\ngoto run\r\n`;
    }

    if (platform === "java") return javaCommand;

    if (!restartSwitch.selected) {
      return `#!/usr/bin/env bash\ncd -- "$(dirname -- "$0")"\n${javaCommand}\n`;
    }
    return `#!/usr/bin/env bash\ncd -- "$(dirname -- "$0")"\nwhile true; do\n  ${javaCommand}\n  sleep 5\ndone\n`;
  }

  function renderScript() {
    if (!output) return;
    if (memoryInput && memoryValue) {
      memoryValue.value = `${memoryInput.value} GB`;
      memoryInput.valueLabel = memoryValue.value;
    }
    const script = getGeneratedScript();
    output.textContent = script ?? "";
    if (script && status) {
      status.textContent =
        platform === "java" && restartSwitch?.selected
          ? generator?.dataset.restartWarning ?? ""
          : "";
    }
  }

  tabs?.addEventListener("change", () => {
    const selectedPlatform = tabs.activeTab?.dataset.platform;
    if (
      selectedPlatform !== "unix" &&
      selectedPlatform !== "windows" &&
      selectedPlatform !== "java"
    ) {
      return;
    }
    platform = selectedPlatform;
    renderScript();
  });

  [fileInput, memoryInput, guiSwitch, restartSwitch, ignoreJavaVersionSwitch].forEach(
    (input) => {
      input?.addEventListener("input", renderScript);
      input?.addEventListener("change", renderScript);
    },
  );

  function syncPresetButtons() {
    presetButtons.forEach((button) => {
      button.selected = button.dataset.preset === preset;
    });
  }

  presetButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const value = button.dataset.preset;
      if (!isPresetId(value)) return;
      preset = value;
      syncPresetButtons();
      syncPresetOptions();
      renderScript();
    });
  });

  openMemoryDialogButton?.addEventListener("click", () => {
    if (!memoryDialog || !memoryInput || !customMemoryInput) return;
    customMemoryInput.value = Number(memoryInput.value).toFixed(2);
    memoryDialog.show();
    customMemoryInput.focus();
  });

  cancelMemoryDialogButton?.addEventListener("click", () => {
    memoryDialog?.close();
  });

  applyMemoryButton?.addEventListener("click", () => {
    if (!memoryDialog || !memoryInput || !customMemoryInput) return;
    const memory = Number(customMemoryInput.value);
    if (!Number.isFinite(memory) || memory < 1 || memory > 32) {
      customMemoryInput.reportValidity();
      return;
    }
    memoryInput.value = memory;
    memoryDialog.close();
    renderScript();
  });

  document.querySelectorAll<HTMLElement>(".memory-preset").forEach((presetButton) => {
    presetButton.addEventListener("click", () => {
      const memory = presetButton.dataset.memory;
      if (!memory || !memoryInput) return;
      memoryInput.value = Number(memory);
      renderScript();
    });
  });

  copyButton?.addEventListener("click", async () => {
    const script = getGeneratedScript();
    if (!script) {
      renderScript();
      return;
    }
    try {
      await navigator.clipboard.writeText(script);
      if (status) status.textContent = generator?.dataset.copied ?? "";
    } catch {
      if (status) status.textContent = generator?.dataset.clipboardError ?? "";
    }
  });

  downloadButton?.addEventListener("click", () => {
    const script = getGeneratedScript();
    if (!script) {
      renderScript();
      return;
    }
    const extension = platform === "windows" ? "bat" : platform === "unix" ? "sh" : "txt";
    const blob = new Blob([script], { type: "text/plain;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.download = `start-server.${extension}`;
    anchor.click();
    URL.revokeObjectURL(url);
    if (status) {
      status.textContent =
        generator?.dataset.downloadedTemplate?.replace(
          "__filename__",
          `start-server.${extension}`,
        ) ?? "";
    }
  });

  syncPresetButtons();
  syncPresetOptions();
  renderScript();
</script>

<style>
  #custom-memory-dialog {
    width: min(28rem, calc(100% - 2rem));
  }

  .option-row:has(md-switch[disabled]) {
    cursor: not-allowed;
    opacity: 0.38;
  }

  .option-row:has(md-switch[disabled]):hover {
    background-color: var(--md-sys-color-surface-container-high);
  }
</style>
