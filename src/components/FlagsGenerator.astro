---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageIntro from "./PageIntro.astro";
import "../styles/global.css";
import { getLocale, getMessages } from "../i18n";

interface Props {
  locale?: string;
}

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);

type PresetOption = {
  id: string;
  label: string;
  description: string;
  href?: string;
};

const presetOptions: PresetOption[] = [
  {
    id: "basic",
    label: t.flags.presets.basic.name,
    description: t.flags.presets.basic.description,
  },
  {
    id: "aikars",
    label: t.flags.presets.aikars.name,
    description: t.flags.presets.aikars.description,
    href: "https://docs.papermc.io/paper/aikars-flags/",
  },
  {
    id: "zgc",
    label: t.flags.presets.zgc.name,
    description: t.flags.presets.zgc.description,
    href: "https://obydux.github.io/Minecraft-startup-flags/",
  },
  {
    id: "shenandoah",
    label: t.flags.presets.shenandoah.name,
    description: t.flags.presets.shenandoah.description,
    href: "https://github.com/brucethemoose/Minecraft-Performance-Flags-Benchmarks",
  },
  {
    id: "velocity",
    label: t.flags.presets.velocity.name,
    description: t.flags.presets.velocity.description,
    href: "https://docs.papermc.io/velocity/getting-started/",
  },
];
---

<Layout title={t.flags.title} locale={locale}>
  <Navbar locale={locale} />
  <main
    id="generator"
    class="pb-12"
    data-filename-error={t.flags.filenameError}
    data-restart-warning={t.flags.javaRestartWarning}
    data-copied={t.flags.copied}
    data-clipboard-error={t.flags.clipboardError}
    data-downloaded-template={t.flags.downloaded("__filename__")}
  >
    <PageIntro eyebrow={t.flags.eyebrow} title={t.flags.title} description={t.flags.description} />
    <section class="mx-auto max-w-4xl px-5 sm:px-8 lg:px-0">
      <div class="m3-card grid gap-5 p-4 sm:gap-6 sm:p-6 md:grid-cols-2">
        <div>
          <label
            for="server-file"
            class="m3-label mb-2 block"
          >
            {t.flags.serverFile}
          </label>
          <input
            id="server-file"
            type="text"
            value="server.jar"
            pattern="[A-Za-z0-9][A-Za-z0-9._-]*\.jar"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="filename-help"
            class="m3-field block min-h-14 w-full px-4 py-3 text-base"
          />
          <p id="filename-help" class="m3-support mt-2">
            {t.flags.filenameHelp}
          </p>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between">
            <label
              for="memory"
              class="m3-label block"
            >
              {t.flags.memory}
            </label>
            <div class="flex items-center gap-2">
              <output
                id="memory-value"
                for="memory"
                class="m3-label"
              >4 GB</output>
              <button
                id="custom-memory-open"
                type="button"
                aria-label={t.flags.advancedMemory}
                aria-haspopup="dialog"
                class="m3-icon-btn"
              >
                <svg
                  aria-hidden="true"
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14.7 6.3a5 5 0 0 0-6.4 6.4L3 18l3 3 5.3-5.3a5 5 0 0 0 6.4-6.4L14 12l-2-2 2.7-3.7Z"></path>
                </svg>
              </button>
            </div>
          </div>
          <div class="relative h-8">
            <input
              id="memory"
              type="range"
              min="1"
              max="32"
              step="0.25"
              value="4"
              aria-valuetext="4 GB"
              class="absolute inset-0 z-20 h-full w-full cursor-pointer opacity-0"
            />
            <div
              class="memory-slider-track m3-slider-track pointer-events-none absolute inset-x-2 top-1/2 h-1 -translate-y-1/2 rounded-full"
              aria-hidden="true"
            >
              <span
                id="memory-slider-fill"
                class="m3-slider-fill absolute inset-y-0 left-0 rounded-full"
                style="width: 9.6774%"
              ></span>
              { [4, 8, 12, 16, 20, 24, 28, 32].map((size) => (
                <span
                  data-memory-tick={size}
                  class="memory-slider-tick m3-slider-tick absolute top-1/2 h-1 w-1 -translate-x-1/2 -translate-y-1/2 rounded-full"
                  style={`left: ${(size - 1) / 31 * 100}%`}
                ></span>
              )) }
              <span
                id="memory-slider-thumb"
                class="m3-slider-thumb absolute left-[9.6774%] top-1/2 z-10 h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full"
              ></span>
            </div>
          </div>
          <div class="relative mt-2 h-5">
            { [4, 8, 12, 16, 20, 24, 28, 32].map((size) => (
              <button
                type="button"
                class="memory-preset m3-memory-preset absolute -translate-x-1/2 whitespace-nowrap"
                data-memory={size}
                aria-label={t.flags.setMemory(size)}
                style={`left: calc(8px + (100% - 16px) * ${(size - 1) / 31})`}
              >
                {size} GB
              </button>
            )) }
          </div>
          <p class="m3-support mt-2">
            {t.flags.memoryHelp}
          </p>
        </div>

        <label class="m3-option">
          <input
            id="enable-gui"
            type="checkbox"
            role="switch"
            class="shrink-0"
          />
          <span>
            <span class="m3-option-title">{t.flags.enableGui}</span>
            <span class="m3-support mt-1 block">
              {t.flags.guiHelp}
            </span>
          </span>
        </label>

        <label class="m3-option">
          <input
            id="auto-restart"
            type="checkbox"
            role="switch"
            class="shrink-0"
          />
          <span>
            <span class="m3-option-title">{t.flags.autoRestart}</span>
            <span class="m3-support mt-1 block">
              {t.flags.restartHelp}
            </span>
          </span>
        </label>

        <label
          id="ignore-java-option"
          class="m3-option md:col-span-2"
        >
          <input
            id="ignore-java-version"
            type="checkbox"
            role="switch"
            class="shrink-0"
          />
          <span>
            <span class="m3-option-title">{t.flags.ignoreJavaVersion}</span>
            <span class="m3-support mt-1 block">
              {t.flags.ignoreJavaVersionHelp}
            </span>
          </span>
        </label>
      </div>

      <section class="m3-card mt-5 p-4 sm:mt-6 sm:p-6">
        <div>
          <h2 class="m3-title">
            {t.flags.presetHeading}
          </h2>
          <p class="m3-support mt-1">
            {t.flags.presetHelp}
          </p>
        </div>
        <ul
          class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-5"
          aria-label={t.flags.presetHeading}
        >
          {presetOptions.map((option) => (
            <li class="flex flex-col">
              <button
                type="button"
                class="preset-option m3-preset"
                aria-pressed={option.id === "aikars" ? "true" : "false"}
                data-preset={option.id}
              >
                <svg
                  class="m3-preset-check"
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m5 13 4 4L19 7"></path>
                </svg>
                <span>{option.label}</span>
              </button>
              <p class="m3-support mt-2">
                {option.description}
                {option.href && (
                  <>
                    {" "}
                    <a
                      class="m3-link whitespace-nowrap"
                      href={option.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {t.flags.learnMore}
                    </a>
                  </>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section class="m3-card mt-6 overflow-hidden sm:mt-8">
        <div class="flex flex-col gap-2 p-2 sm:flex-row sm:items-center sm:justify-between sm:p-3">
          <div
            class="m3-tabs"
            role="tablist"
            aria-label={t.flags.outputFormat}
          >
            <button
              type="button"
              class="platform-tab m3-tab text-xs sm:text-sm"
              role="tab"
              aria-selected="true"
              data-platform="unix"
            >
              Linux / macOS
            </button>
            <button
              type="button"
              class="platform-tab m3-tab text-xs sm:text-sm"
              role="tab"
              aria-selected="false"
              data-platform="windows"
            >
              Windows
            </button>
            <button
              type="button"
              class="platform-tab m3-tab text-xs sm:text-sm"
              role="tab"
              aria-selected="false"
              data-platform="java"
            >
              {t.flags.javaCommand}
            </button>
          </div>
          <div class="flex gap-2 px-1 pb-1 sm:shrink-0 sm:px-0 sm:pb-0">
            <button
              id="copy-script"
              type="button"
              class="m3-btn m3-btn-outlined min-h-11 flex-1 sm:flex-none"
            >
              {t.flags.copy}
            </button>
            <button
              id="download-script"
              type="button"
              class="m3-btn m3-btn-filled min-h-11 flex-1 sm:flex-none"
            >
              {t.flags.download}
            </button>
          </div>
        </div>
        <pre class="m3-code min-h-48 overflow-x-auto p-4 text-xs leading-6 sm:p-5 sm:text-sm"><code id="script-output"></code></pre>
        <p
          id="generator-status"
          class="m3-support min-h-10 px-4 py-3"
          aria-live="polite"
        ></p>
      </section>

      <p class="m3-support mt-6">
        {t.flags.attributionStart}
        <a
          class="m3-link"
          href="https://flags.sh/"
          target="_blank"
          rel="noopener noreferrer"
        >flags.sh</a>
        {t.flags.attributionBy}
        <a
          class="m3-link"
          href="https://github.com/YouHaveTrouble/flags.sh"
          target="_blank"
          rel="noopener noreferrer"
        >YouHaveTrouble</a>
        {t.flags.attributionEnd}
      </p>
      <p class="m3-support mt-2">
        {t.flags.presetAttributionStart}
        <a
          class="m3-link"
          href="https://flectone.net/en/tools/server-flags-generator"
          target="_blank"
          rel="noopener noreferrer"
        >{t.flags.presetAttributionLink}</a>
        {t.flags.presetAttributionEnd}
      </p>
    </section>
    <dialog
      id="custom-memory-dialog"
      aria-labelledby="custom-memory-title"
      class="m3-dialog fixed inset-0 m-auto w-[min(28rem,calc(100%-2rem))] p-0"
    >
      <form id="custom-memory-form" class="p-5 sm:p-6">
        <h2 id="custom-memory-title" class="m3-dialog-title mb-5">
          {t.flags.advancedOptions}
        </h2>
        <label for="custom-memory" class="m3-label mb-2 block">
          {t.flags.customMemory}
        </label>
        <input
          id="custom-memory"
          type="number"
          min="1"
          max="32"
          step="0.25"
          value="4.00"
          required
          inputmode="decimal"
          class="m3-field block min-h-14 w-full px-4 py-3 text-base"
        />
        <p class="m3-support mt-2">
          {t.flags.customMemoryHelp}
        </p>
        <div class="mt-6 flex justify-end gap-2">
          <button
            id="custom-memory-cancel"
            type="button"
            class="m3-btn m3-btn-text min-h-10"
          >
            {t.flags.cancel}
          </button>
          <button
            type="submit"
            class="m3-btn m3-btn-filled min-h-10"
          >
            {t.flags.apply}
          </button>
        </div>
      </form>
    </dialog>
  </main>
  <Footer locale={locale} />
</Layout>

<script>
  type Platform = "unix" | "windows" | "java";
  type PresetId = "basic" | "aikars" | "zgc" | "shenandoah" | "velocity";

  const fileInput = document.querySelector<HTMLInputElement>("#server-file");
  const memoryInput = document.querySelector<HTMLInputElement>("#memory");
  const memoryValue = document.querySelector<HTMLOutputElement>("#memory-value");
  const memoryTicks = document.querySelectorAll<HTMLElement>("[data-memory-tick]");
  const memorySliderFill = document.querySelector<HTMLElement>("#memory-slider-fill");
  const memorySliderThumb = document.querySelector<HTMLElement>("#memory-slider-thumb");
  const memoryDialog = document.querySelector<HTMLDialogElement>("#custom-memory-dialog");
  const memoryForm = document.querySelector<HTMLFormElement>("#custom-memory-form");
  const customMemoryInput = document.querySelector<HTMLInputElement>("#custom-memory");
  const openMemoryDialogButton = document.querySelector<HTMLButtonElement>("#custom-memory-open");
  const cancelMemoryDialogButton = document.querySelector<HTMLButtonElement>("#custom-memory-cancel");
  const guiCheckbox = document.querySelector<HTMLInputElement>("#enable-gui");
  const restartCheckbox = document.querySelector<HTMLInputElement>("#auto-restart");
  const ignoreJavaVersionCheckbox =
    document.querySelector<HTMLInputElement>("#ignore-java-version");
  const presetButtons = document.querySelectorAll<HTMLButtonElement>(".preset-option");
  const output = document.querySelector<HTMLElement>("#script-output");
  const status = document.querySelector<HTMLElement>("#generator-status");
  const copyButton = document.querySelector<HTMLButtonElement>("#copy-script");
  const downloadButton = document.querySelector<HTMLButtonElement>("#download-script");
  const tabs = document.querySelectorAll<HTMLButtonElement>(".platform-tab");
  const generator = document.querySelector<HTMLElement>("#generator");

  let platform: Platform = "unix";
  let preset: PresetId = "aikars";

  function isPresetId(value: string | undefined): value is PresetId {
    return (
      value === "basic" ||
      value === "aikars" ||
      value === "zgc" ||
      value === "shenandoah" ||
      value === "velocity"
    );
  }

  function buildFlags(memoryGb: number): string[] {
    const memory = Math.round(memoryGb * 1024);
    const heap = [`-Xms${memory}M`, `-Xmx${memory}M`];
    const vectorModule = "--add-modules=jdk.incubator.vector";
    const ignoreJavaVersion = ignoreJavaVersionCheckbox?.checked
      ? ["-Dpaper.ignoreJavaVersion=true"]
      : [];

    switch (preset) {
      case "basic":
        return [...heap, vectorModule, ...ignoreJavaVersion];
      case "zgc":
        return [
          ...heap,
          vectorModule,
          "-XX:+UseZGC",
          "-XX:+ZGenerational",
          "-XX:+AlwaysPreTouch",
          "-XX:+UseStringDeduplication",
          "-XX:TrimNativeHeapInterval=5000",
          ...ignoreJavaVersion,
        ];
      case "shenandoah":
        return [
          ...heap,
          vectorModule,
          "-XX:+UseShenandoahGC",
          "-XX:ShenandoahGCMode=iu",
          "-XX:ShenandoahGuaranteedGCInterval=1000000",
          "-XX:+AlwaysPreTouch",
          "-XX:+DisableExplicitGC",
          "-XX:AllocatePrefetchStyle=1",
          ...ignoreJavaVersion,
        ];
      case "velocity":
        return [
          ...heap,
          "-XX:+UseG1GC",
          "-XX:G1HeapRegionSize=4M",
          "-XX:+UnlockExperimentalVMOptions",
          "-XX:+ParallelRefProcEnabled",
          "-XX:+AlwaysPreTouch",
          "-XX:MaxInlineLevel=15",
        ];
      case "aikars": {
        const largeHeap = Math.floor(memoryGb) >= 12;
        return [
          ...heap,
          vectorModule,
          "-XX:+UseG1GC",
          "-XX:+ParallelRefProcEnabled",
          "-XX:MaxGCPauseMillis=200",
          "-XX:+UnlockExperimentalVMOptions",
          "-XX:+DisableExplicitGC",
          "-XX:+AlwaysPreTouch",
          `-XX:G1NewSizePercent=${largeHeap ? 40 : 30}`,
          `-XX:G1MaxNewSizePercent=${largeHeap ? 50 : 40}`,
          `-XX:G1HeapRegionSize=${largeHeap ? 16 : 8}M`,
          `-XX:G1ReservePercent=${largeHeap ? 15 : 20}`,
          "-XX:G1HeapWastePercent=5",
          "-XX:G1MixedGCCountTarget=4",
          "-XX:InitiatingHeapOccupancyPercent=15",
          "-XX:G1MixedGCLiveThresholdPercent=90",
          "-XX:G1RSetUpdatingPauseTimePercent=5",
          "-XX:SurvivorRatio=32",
          "-XX:+PerfDisableSharedMem",
          "-XX:MaxTenuringThreshold=1",
          "-Dusing.aikars.flags=https://mcflags.emc.gs",
          "-Daikars.new.flags=true",
          ...ignoreJavaVersion,
        ];
      }
    }
  }

  function syncPresetOptions() {
    const isProxy = preset === "velocity";
    const isBasic = preset === "basic";

    if (guiCheckbox) {
      if (isProxy) guiCheckbox.checked = false;
      guiCheckbox.disabled = isProxy;
    }

    if (ignoreJavaVersionCheckbox) {
      if (isBasic || isProxy) ignoreJavaVersionCheckbox.checked = false;
      ignoreJavaVersionCheckbox.disabled = isBasic || isProxy;
    }
  }

  function getGeneratedScript(): string | null {
    if (!fileInput || !memoryInput || !guiCheckbox || !restartCheckbox) return null;

    const filename = fileInput.value.trim();
    if (!/^[A-Za-z0-9][A-Za-z0-9._-]*\.jar$/i.test(filename)) {
      if (status) {
        status.textContent = generator?.dataset.filenameError ?? "";
      }
      return null;
    }

    const memory = Number(memoryInput.value);
    const flags = buildFlags(memory).join(" ");
    const serverOptions = preset === "velocity" || guiCheckbox.checked ? "" : " --nogui";
    const javaCommand = `java ${flags} -jar "${filename}"${serverOptions}`;

    if (platform === "windows") {
      if (!restartCheckbox.checked) return `@echo off\r\ncd /d "%~dp0"\r\n${javaCommand}\r\n`;
      return `@echo off\r\ncd /d "%~dp0"\r\n:run\r\n${javaCommand}\r\ntimeout /t 5 /nobreak >nul\r\ngoto run\r\n`;
    }

    if (platform === "java") return javaCommand;

    if (!restartCheckbox.checked) {
      return `#!/usr/bin/env bash\ncd -- "$(dirname -- "$0")"\n${javaCommand}\n`;
    }
    return `#!/usr/bin/env bash\ncd -- "$(dirname -- "$0")"\nwhile true; do\n  ${javaCommand}\n  sleep 5\ndone\n`;
  }

  function renderScript() {
    if (!output) return;
    if (memoryInput && memoryValue) {
      memoryValue.value = `${memoryInput.value} GB`;
      memoryInput.setAttribute("aria-valuetext", memoryValue.value);
      const progress = ((Number(memoryInput.value) - 1) / 31) * 100;
      if (memorySliderFill) memorySliderFill.style.width = `${progress}%`;
      if (memorySliderThumb) memorySliderThumb.style.left = `${progress}%`;
      memoryTicks.forEach((tick) => {
        const tickValue = Number(tick.dataset.memoryTick);
        tick.classList.toggle("invisible", tickValue === Number(memoryInput.value));
        tick.classList.toggle("is-passed", tickValue < Number(memoryInput.value));
      });
    }
    const script = getGeneratedScript();
    output.textContent = script ?? "";
    if (script && status) {
      status.textContent =
        platform === "java" && restartCheckbox?.checked
          ? generator?.dataset.restartWarning ?? ""
          : "";
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const selectedPlatform = tab.dataset.platform;
      if (selectedPlatform !== "unix" && selectedPlatform !== "windows" && selectedPlatform !== "java") return;
      platform = selectedPlatform;
      tabs.forEach((item) => {
        item.setAttribute("aria-selected", String(item === tab));
      });
      renderScript();
    });
  });

  [fileInput, memoryInput, guiCheckbox, restartCheckbox, ignoreJavaVersionCheckbox].forEach(
    (input) => {
      input?.addEventListener("input", renderScript);
      input?.addEventListener("change", renderScript);
    },
  );

  function syncPresetButtons() {
    presetButtons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.preset === preset),
      );
    });
  }

  presetButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const value = button.dataset.preset;
      if (!isPresetId(value)) return;
      preset = value;
      syncPresetButtons();
      syncPresetOptions();
      renderScript();
    });
  });

  openMemoryDialogButton?.addEventListener("click", () => {
    if (!memoryDialog || !memoryInput || !customMemoryInput) return;
    customMemoryInput.value = Number(memoryInput.value).toFixed(2);
    memoryDialog.showModal();
    customMemoryInput.focus();
    customMemoryInput.select();
  });

  cancelMemoryDialogButton?.addEventListener("click", () => {
    memoryDialog?.close();
  });

  memoryForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!memoryDialog || !memoryInput || !customMemoryInput) return;
    const memory = Number(customMemoryInput.value);
    if (!Number.isFinite(memory) || memory < 1 || memory > 32) {
      customMemoryInput.reportValidity();
      return;
    }
    memoryInput.value = String(memory);
    memoryDialog.close();
    renderScript();
  });

  document.querySelectorAll<HTMLButtonElement>(".memory-preset").forEach((preset) => {
    preset.addEventListener("click", () => {
      if (!memoryInput) return;
      const memory = preset.dataset.memory;
      if (!memory) return;
      memoryInput.value = memory;
      renderScript();
    });
  });

  copyButton?.addEventListener("click", async () => {
    const script = getGeneratedScript();
    if (!script) {
      renderScript();
      return;
    }
    try {
      await navigator.clipboard.writeText(script);
      if (status) status.textContent = generator?.dataset.copied ?? "";
    } catch {
      if (status) status.textContent = generator?.dataset.clipboardError ?? "";
    }
  });

  downloadButton?.addEventListener("click", () => {
    const script = getGeneratedScript();
    if (!script) {
      renderScript();
      return;
    }
    const extension = platform === "windows" ? "bat" : platform === "unix" ? "sh" : "txt";
    const blob = new Blob([script], { type: "text/plain;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.download = `start-server.${extension}`;
    anchor.click();
    URL.revokeObjectURL(url);
    if (status) {
      status.textContent =
        generator?.dataset.downloadedTemplate?.replace(
          "__filename__",
          `start-server.${extension}`,
        ) ?? "";
    }
  });

  syncPresetButtons();
  syncPresetOptions();
  renderScript();
</script>

<style>

  .m3-card {
    background-color: var(--m3-card-surface);
    border-radius: 1.75rem;
    color: var(--m3-on-surface);
  }

  .m3-title {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5rem;
    color: var(--m3-on-surface);
  }

  .m3-label {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
    color: var(--m3-on-surface);
  }

  .m3-support {
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1rem;
    color: var(--m3-on-surface-variant);
  }

  .m3-link {
    color: var(--m3-primary);
    font-weight: 500;
  }

  .m3-link:hover {
    text-decoration: underline;
