---
import SmallCard from "./Small-Card.astro";
import {
  websiteCategories,
  type WebsiteCategory,
  type WebsiteLink,
} from "../lib/website-links";

interface Props {
  websites: WebsiteLink[];
  locale: string;
  searchId: string;
  listId: string;
  searchLabel: string;
  searchPlaceholder: string;
  clearLabel: string;
  foundTemplate: string;
  notFoundTemplate: string;
  totalTemplate: string;
  filterLabel: string;
  allLabel: string;
  noResultsLabel: string;
  categoryLabels: Record<WebsiteCategory, string>;
}

const {
  websites,
  locale,
  searchId,
  listId,
  searchLabel,
  searchPlaceholder,
  clearLabel,
  foundTemplate,
  notFoundTemplate,
  totalTemplate,
  filterLabel,
  allLabel,
  noResultsLabel,
  categoryLabels,
} = Astro.props;

const categories = websiteCategories.filter((category) =>
  websites.some((website) => website.categories.includes(category)),
);
---

<section class="mx-auto max-w-screen-xl px-5 pb-20 sm:px-8 lg:px-10">
  <div class="surface-panel p-3 sm:p-5">
    <div role="search">
      <md-outlined-text-field
        id={searchId}
        type="search"
        class="search-field"
        aria-label={searchLabel}
        placeholder={searchPlaceholder}
        aria-controls={listId}
        autocomplete="off"
        spellcheck="false"
        has-leading-icon
        has-trailing-icon
        data-website-search
      >
        <span slot="leading-icon" class="material-symbols-outlined" aria-hidden="true">search</span>
        <md-icon-button
          slot="trailing-icon"
          type="button"
          data-website-clear
          aria-label={clearLabel}
          class="[--md-icon-button-icon-color:var(--md-sys-color-on-surface-variant)]"
          hidden
        >
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </md-icon-button>
      </md-outlined-text-field>
    </div>
    <div class="mt-3" role="group" aria-label={filterLabel} data-website-filters>
      <div class="flex gap-2 overflow-x-auto pb-1 sm:flex-wrap sm:overflow-visible sm:pb-0">
        <md-filter-chip data-website-category="all" selected class="shrink-0">
          {allLabel}
        </md-filter-chip>
        {categories.map((category) => (
          <md-filter-chip
            data-website-category={category}
            class="shrink-0"
          >
            {categoryLabels[category]}
          </md-filter-chip>
        ))}
      </div>
    </div>
    <p
      class="mt-3 px-4 text-xs font-medium leading-4 text-[var(--md-sys-color-on-surface-variant)]"
      role="status"
      aria-live="polite"
      data-website-search-status
      data-found-template={foundTemplate}
      data-not-found-template={notFoundTemplate}
      data-total-template={totalTemplate}
      data-no-results-label={noResultsLabel}
    ></p>
  </div>
  <div id={listId} class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {websites.map((website) => <SmallCard locale={locale} {...website} />)}
  </div>
</section>

<script>
  import "@material/web/textfield/outlined-text-field.js";
  import "@material/web/iconbutton/icon-button.js";
  import "@material/web/chips/filter-chip.js";

  type TextField = HTMLElement & { value: string; focus(): void };
  type FilterChip = HTMLElement & { selected: boolean };

  const searchInput = document.querySelector<TextField>("[data-website-search]");
  const clearButton = document.querySelector<HTMLElement>("[data-website-clear]");
  const resultStatus = document.querySelector<HTMLElement>(
    "[data-website-search-status]",
  );
  const filterButtons = Array.from(
    document.querySelectorAll<FilterChip>("[data-website-category]"),
  );
  const listId = searchInput?.getAttribute("aria-controls");
  const cards = listId
    ? Array.from(
        document.querySelectorAll<HTMLAnchorElement>(`#${CSS.escape(listId)} > a`),
      )
    : [];

  if (searchInput && resultStatus) {
    const format = (template: string | undefined, placeholder: string, value: string) =>
      (template ?? "").replace(placeholder, value);
    let activeCategory = "all";

    const syncClearButton = () => {
      if (clearButton) clearButton.hidden = searchInput.value.length === 0;
    };

    const filterCards = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      for (const card of cards) {
        const searchableText = `${card.textContent ?? ""} ${card.href}`.toLowerCase();
        const cardCategories = (card.dataset.categories ?? "").split(" ");
        const matchesCategory =
          activeCategory === "all" || cardCategories.includes(activeCategory);
        const isMatch = matchesCategory && searchableText.includes(query);
        card.style.display = isMatch ? "" : "none";
        if (isMatch) visibleCount++;
      }

      if (query) {
        resultStatus.textContent =
          visibleCount > 0
            ? format(resultStatus.dataset.foundTemplate, "{count}", String(visibleCount))
            : format(
                resultStatus.dataset.notFoundTemplate,
                "{query}",
                searchInput.value.trim(),
              );
      } else if (visibleCount === 0) {
        resultStatus.textContent = resultStatus.dataset.noResultsLabel ?? "";
      } else {
        resultStatus.textContent = format(
          resultStatus.dataset.totalTemplate,
          "{count}",
          String(visibleCount),
        );
      }

      syncClearButton();
    };

    for (const button of filterButtons) {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.websiteCategory ?? "all";
        for (const otherButton of filterButtons) {
          otherButton.selected = otherButton === button;
        }
        filterCards();
      });
    }

    const clearSearch = () => {
      searchInput.value = "";
      filterCards();
      searchInput.focus();
    };

    clearButton?.addEventListener("click", clearSearch);
    searchInput.addEventListener("keydown", (event) => {
      const keyboardEvent = event as KeyboardEvent;
      if (keyboardEvent.key === "Escape" && searchInput.value) {
        keyboardEvent.preventDefault();
        clearSearch();
      }
    });
    searchInput.addEventListener("input", filterCards);
    filterCards();
  }
</script>
