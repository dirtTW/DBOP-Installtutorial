---
import SmallCard from "./Small-Card.astro";
import {
  websiteCategories,
  type WebsiteCategory,
  type WebsiteLink,
} from "../lib/website-links";

interface Props {
  websites: WebsiteLink[];
  locale: string;
  searchId: string;
  listId: string;
  searchLabel: string;
  searchPlaceholder: string;
  foundTemplate: string;
  notFoundTemplate: string;
  totalTemplate: string;
  filterLabel: string;
  allLabel: string;
  noResultsLabel: string;
  categoryLabels: Record<WebsiteCategory, string>;
}

const {
  websites,
  locale,
  searchId,
  listId,
  searchLabel,
  searchPlaceholder,
  foundTemplate,
  notFoundTemplate,
  totalTemplate,
  filterLabel,
  allLabel,
  noResultsLabel,
  categoryLabels,
} = Astro.props;

const categories = websiteCategories.filter((category) =>
  websites.some((website) => website.categories.includes(category)),
);

const chipClass =
  "inline-flex min-h-10 shrink-0 items-center rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:bg-brand-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 aria-pressed:border-brand-700 aria-pressed:bg-brand-700 aria-pressed:text-white dark:border-white/10 dark:bg-[#111318] dark:text-zinc-300 dark:hover:bg-[#252a31] dark:aria-pressed:border-[#d4e3ff] dark:aria-pressed:bg-[#d4e3ff] dark:aria-pressed:text-[#102f54]";
---

<section class="mx-auto max-w-screen-xl px-5 pb-20 sm:px-8 lg:px-10">
  <div class="mb-6 rounded-2xl border border-brand-100 bg-brand-50/70 p-4 dark:border-white/10 dark:bg-[#1c1f25] sm:p-5">
    <label for={searchId} class="sr-only">{searchLabel}</label>
    <input
      id={searchId}
      type="search"
      placeholder={searchPlaceholder}
      aria-controls={listId}
      data-website-search
      class="block w-full min-w-0 rounded-xl border border-brand-200 bg-white px-4 py-3 text-base text-zinc-900 placeholder:text-zinc-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-white/10 dark:bg-[#111318] dark:text-white dark:placeholder:text-zinc-500 sm:text-sm"
    />
    <div class="mt-3" role="group" aria-label={filterLabel} data-website-filters>
      <div class="flex gap-2 overflow-x-auto pb-1 sm:flex-wrap sm:overflow-visible sm:pb-0">
        <button type="button" class={chipClass} data-website-category="all" aria-pressed="true">
          {allLabel}
        </button>
        {categories.map((category) => (
          <button
            type="button"
            class={chipClass}
            data-website-category={category}
            aria-pressed="false"
          >
            {categoryLabels[category]}
          </button>
        ))}
      </div>
    </div>
    <p
      class="mt-3 text-xs font-medium text-zinc-500 dark:text-zinc-400"
      role="status"
      aria-live="polite"
      data-website-search-status
      data-found-template={foundTemplate}
      data-not-found-template={notFoundTemplate}
      data-total-template={totalTemplate}
      data-no-results-label={noResultsLabel}
    ></p>
  </div>
  <div id={listId} class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {websites.map((website) => <SmallCard locale={locale} {...website} />)}
  </div>
</section>

<script>
  const searchInput = document.querySelector<HTMLInputElement>(
    "[data-website-search]",
  );
  const resultStatus = document.querySelector<HTMLElement>(
    "[data-website-search-status]",
  );
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-website-category]"),
  );
  const listId = searchInput?.getAttribute("aria-controls");
  const cards = listId
    ? Array.from(
        document.querySelectorAll<HTMLAnchorElement>(`#${CSS.escape(listId)} > a`),
      )
    : [];

  if (searchInput && resultStatus) {
    const format = (template: string | undefined, placeholder: string, value: string) =>
      (template ?? "").replace(placeholder, value);
    let activeCategory = "all";

    const filterCards = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      for (const card of cards) {
        const searchableText = `${card.textContent ?? ""} ${card.href}`.toLowerCase();
        const cardCategories = (card.dataset.categories ?? "").split(" ");
        const matchesCategory =
          activeCategory === "all" || cardCategories.includes(activeCategory);
        const isMatch = matchesCategory && searchableText.includes(query);
        card.style.display = isMatch ? "" : "none";
        if (isMatch) visibleCount++;
      }

      if (query) {
        resultStatus.textContent =
          visibleCount > 0
            ? format(resultStatus.dataset.foundTemplate, "{count}", String(visibleCount))
            : format(
                resultStatus.dataset.notFoundTemplate,
                "{query}",
                searchInput.value.trim(),
              );
      } else if (visibleCount === 0) {
        resultStatus.textContent = resultStatus.dataset.noResultsLabel ?? "";
      } else {
        resultStatus.textContent = format(
          resultStatus.dataset.totalTemplate,
          "{count}",
          String(visibleCount),
        );
      }
    };

    for (const button of filterButtons) {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.websiteCategory ?? "all";
        for (const otherButton of filterButtons) {
          otherButton.setAttribute("aria-pressed", String(otherButton === button));
        }
        filterCards();
      });
    }

    searchInput.addEventListener("input", filterCards);
    filterCards();
  }
</script>
