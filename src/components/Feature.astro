---
import { getLocale, getMessages, localizedPath } from "../i18n";
import mcLogo from "../img/mclogo.webp";
import dbopLogo from "../img/logo.webp";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
const features = [
  {
    name: "Sodium",
    description: t.home.sodium,
    image: "https://cdn.modrinth.com/data/AANobbMI/icon.png",
    href: "https://modrinth.com/mod/sodium",
    category: t.home.performanceTag,
  },
  {
    name: "Iris",
    description: t.home.iris,
    image: "https://cdn.modrinth.com/data/YL57xq9U/icon.png",
    href: "https://modrinth.com/mod/iris",
    category: t.home.visualsTag,
  },
  {
    name: t.home.vanillaTitle,
    description: t.home.vanilla,
    image: mcLogo.src,
    category: t.home.qualityTag,
  },
  {
    name: "ModernFix",
    description: t.home.modernfix,
    image: "https://cdn.modrinth.com/data/nmDcB62a/e1d2433476995be1b1a94ff1afaf6167752274ae.png",
    href: "https://modrinth.com/mod/modernfix",
    category: t.home.performanceTag,
  },
  {
    name: "spark",
    description: t.home.spark,
    image: "https://cdn.modrinth.com/data/l6YH9Als/13676ddae142a85998c1c0086cafc30ce2efde80.png",
    href: "https://modrinth.com/mod/spark",
    category: t.home.qualityTag,
  },
  {
    name: t.home.more,
    description: t.home.tryIt,
    image: dbopLogo.src,
    href: localizedPath(locale, "recommended-modpacks"),
    category: t.home.packLabel,
  },
];
---

<section class="bg-[#f7f9ff] dark:bg-[#111318]" id="learnmore">
  <div class="mx-auto max-w-screen-xl px-5 py-20 sm:px-8 sm:py-24 lg:px-10">
    <div class="mb-10 flex flex-col gap-5 sm:mb-14 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-brand-700 dark:text-brand-400">{t.home.featureEyebrow}</p>
        <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-zinc-950 sm:text-4xl dark:text-white">
        DBOP (DirtTW's Basement Optimize Pack)
        </h2>
        <p class="text-zinc-600 sm:text-lg dark:text-zinc-400">
          {t.home.features}
        </p>
      </div>
      <a
        href={localizedPath(getLocale(Astro.props.locale ?? Astro.currentLocale), "recommended-modpacks")}
        class="inline-flex min-h-12 shrink-0 items-center gap-2 rounded-full px-5 font-semibold text-brand-700 transition hover:bg-brand-100 dark:text-[#d4e3ff] dark:hover:bg-white/10"
      >
        {t.home.explorePacks}
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L8.5 3.5M13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <article class="group relative rounded-[1.75rem] bg-[#eef2f9] p-5 transition duration-200 hover:-translate-y-0.5 hover:bg-brand-100 hover:shadow-md hover:shadow-black/5 dark:bg-[#1c1f25] dark:hover:bg-[#252a31] sm:p-6">
          <div class="mb-5 flex items-center justify-between">
            <img class="h-12 w-12 rounded-2xl object-cover" src={feature.image} alt="" width="48" height="48" loading="lazy" />
            <span class="rounded-full bg-[#dce6f5] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-brand-800 dark:bg-[#30343b] dark:text-[#d4e3ff]">{feature.category}</span>
          </div>
          <h3 class="mb-2 text-lg font-bold text-zinc-900 dark:text-white">
            {feature.href ? <a href={feature.href} class="after:absolute after:inset-0">{feature.name}</a> : feature.name}
          </h3>
          <p class="text-sm leading-6 text-zinc-600 dark:text-zinc-400">{feature.description}</p>
          {feature.href && <div class="relative mt-5 border-t border-brand-200/70 pt-4 text-xs font-semibold text-brand-700 dark:border-white/10 dark:text-[#d4e3ff]">{t.home.learnMore} <span aria-hidden="true">→</span></div>}
        </article>
      ))}
    </div>
  </div>
</section>
