---
import { getLocale, getMessages, localizedPath } from "../i18n";
import { Image } from "astro:assets";
import mcLogo from "../img/mclogo.webp";
import dbopLogo from "../img/logo.webp";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
const features = [
  {
    name: "Sodium",
    description: t.home.sodium,
    image: "https://cdn.modrinth.com/data/AANobbMI/icon.png",
    href: "https://modrinth.com/mod/sodium",
    category: t.home.performanceTag,
  },
  {
    name: "Iris",
    description: t.home.iris,
    image: "https://cdn.modrinth.com/data/YL57xq9U/icon.png",
    href: "https://modrinth.com/mod/iris",
    category: t.home.visualsTag,
  },
  {
    name: t.home.vanillaTitle,
    description: t.home.vanilla,
    image: mcLogo.src,
    category: t.home.qualityTag,
  },
  {
    name: "ModernFix",
    description: t.home.modernfix,
    image: "https://cdn.modrinth.com/data/nmDcB62a/e1d2433476995be1b1a94ff1afaf6167752274ae.png",
    href: "https://modrinth.com/mod/modernfix",
    category: t.home.performanceTag,
  },
  {
    name: "spark",
    description: t.home.spark,
    image: "https://cdn.modrinth.com/data/l6YH9Als/13676ddae142a85998c1c0086cafc30ce2efde80.png",
    href: "https://modrinth.com/mod/spark",
    category: t.home.qualityTag,
  },
  {
    name: t.home.more,
    description: t.home.tryIt,
    image: dbopLogo.src,
    href: localizedPath(locale, "recommended-modpacks"),
    category: t.home.packLabel,
  },
];
---

<section id="learnmore">
  <div class="mx-auto max-w-screen-xl px-5 py-20 sm:px-8 sm:py-24 lg:px-10">
    <div class="mb-10 flex flex-col gap-5 sm:mb-14 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--md-sys-color-primary)]">{t.home.featureEyebrow}</p>
        <h2 class="mb-4 text-[1.875rem] font-medium leading-[1.2] tracking-[-0.01em]">
        DBOP (DirtTW's Basement Optimize Pack)
        </h2>
        <p class="text-base leading-6 text-[var(--md-sys-color-on-surface-variant)]">
          {t.home.features}
        </p>
      </div>
      <md-text-button
        href={localizedPath(getLocale(Astro.props.locale ?? Astro.currentLocale), "recommended-modpacks")}
        class="shrink-0 [--md-text-button-container-height:3rem]"
      >
        {t.home.explorePacks}
        <span slot="icon" class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </md-text-button>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <article class="surface-card feature-card group relative p-5 sm:p-6">
          <div class="mb-5 flex items-center justify-between">
            {typeof feature.image === "string" ? (
              <img class="h-12 w-12 rounded-2xl object-cover" src={feature.image} alt="" width="48" height="48" loading="lazy" />
            ) : (
              <Image class="h-12 w-12 rounded-2xl object-cover" src={feature.image} alt="" width={48} height={48} format="webp" />
            )}
            <span class="rounded-full bg-[var(--md-sys-color-secondary-container)] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-[var(--md-sys-color-on-secondary-container)]">{feature.category}</span>
          </div>
          <h3 class="mb-2 text-lg font-medium leading-6">
            {feature.href ? <a href={feature.href} class="after:absolute after:inset-0">{feature.name}</a> : feature.name}
          </h3>
          <p class="text-sm leading-5 text-[var(--md-sys-color-on-surface-variant)]">{feature.description}</p>
          {feature.href && <div class="relative mt-5 border-t border-[var(--md-sys-color-outline-variant)] pt-4 text-xs font-semibold text-[var(--md-sys-color-primary)]">{t.home.learnMore} <span aria-hidden="true">→</span></div>}
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import "@material/web/button/text-button.js";
</script>

<style>
  .feature-card {
    transition:
      background-color 180ms cubic-bezier(0.2, 0, 0, 1),
      box-shadow 180ms cubic-bezier(0.2, 0, 0, 1);
  }

  .feature-card:hover {
    background-color: color-mix(
      in srgb,
      var(--md-sys-color-on-surface) 5%,
      var(--md-sys-color-surface-container-low)
    );
    box-shadow:
      0 1px 3px 1px rgb(0 0 0 / 0.12),
      0 1px 2px rgb(0 0 0 / 0.24);
  }
</style>
