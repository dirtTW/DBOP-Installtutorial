---
import { getLocale, getMessages } from "../i18n";

const t = getMessages(getLocale(Astro.props.locale ?? Astro.currentLocale));
---

<section class="bg-white dark:bg-zinc-900" id="learnmore">
  <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
    <div class="max-w-screen-md mb-8 lg:mb-16">
      <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-zinc-900 dark:text-white">
        DBOP (DirtTW's Basement Optimize Pack)
      </h2>
      <p class="text-zinc-500 sm:text-xl dark:text-zinc-400">
        {t.home.features}
      </p>
    </div>
    <div class="space-y-8 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-12 md:space-y-0">
      <div>
        <img
          class="mb-5 rounded-full w-20 h-20 text-primary-600 dark:text-primary-300 max-sm:mx-auto"
          src="https://cdn.modrinth.com/data/AANobbMI/icon.png"
          alt="Sodium"
        />
        <h3 class="mb-2 text-xl font-bold dark:text-white max-sm:text-center">
          <a href="https://modrinth.com/mod/sodium">Sodium</a>
        </h3>
        <p class="text-zinc-500 dark:text-zinc-400 max-sm:text-center">
          {t.home.sodium}
        </p>
      </div>
      <div>
        <img
          class="mb-5 rounded-full w-20 h-20 text-primary-600 dark:text-primary-300 max-sm:mx-auto"
          src="https://cdn.modrinth.com/data/YL57xq9U/icon.png"
          alt="Iris"
        />
        <h3 class="mb-2 text-xl font-bold dark:text-white max-sm:text-center">
          <a href="https://modrinth.com/mod/iris">Iris</a>
        </h3>
        <p class="text-zinc-500 dark:text-zinc-400 max-sm:text-center">
          {t.home.iris}
        </p>
      </div>
      <div>
        <img
          class="mb-5 rounded-full w-20 h-20 text-primary-600 dark:text-primary-300 max-sm:mx-auto"
          src="https://raw.githubusercontent.com/yichifauzi/DBOP-Installtutorial/master/public/img/mclogo.webp"
          alt="MC logo"
        />
        <h3 class="mb-2 text-xl font-bold dark:text-white max-sm:text-center">
          {t.home.vanillaTitle}
        </h3>
        <p class="text-zinc-500 dark:text-zinc-400 max-sm:text-center">
          {t.home.vanilla}
        </p>
      </div>
      <div>
        <img
          class="mb-5 rounded-full w-20 h-20 text-primary-600 dark:text-primary-300 max-sm:mx-auto"
          src="https://cdn.modrinth.com/data/nmDcB62a/e1d2433476995be1b1a94ff1afaf6167752274ae.png"
          alt="ModernFix"
        />
        <h3 class="mb-2 text-xl font-bold dark:text-white max-sm:text-center">
          <a href="https://modrinth.com/mod/modernfix">ModernFix</a>
        </h3>
        <p class="text-zinc-500 dark:text-zinc-400 max-sm:text-center">
          {t.home.modernfix}
        </p>
      </div>
      <div>
        <img
          class="mb-5 rounded-full w-20 h-20 text-primary-600 dark:text-primary-300 max-sm:mx-auto"
          src="https://cdn.modrinth.com/data/l6YH9Als/13676ddae142a85998c1c0086cafc30ce2efde80.png"
          alt="Spark"
        />
        <h3 class="mb-2 text-xl font-bold dark:text-white max-sm:text-center">
          <a href="https://modrinth.com/mod/spark">Spark</a>
        </h3>
        <p class="text-zinc-500 dark:text-zinc-400 max-sm:text-center">
          {t.home.spark}
        </p>
      </div>
      <div>
        <img
          class="mb-5 rounded-full w-20 h-20 text-primary-600 dark:text-primary-300 max-sm:mx-auto"
          src="https://raw.githubusercontent.com/yichifauzi/DBOP-Installtutorial/master/public/img/logo.webp"
          alt=""
        />
        <h3 class="mb-2 text-xl font-bold dark:text-white max-sm:text-center">
          {t.home.more}
        </h3>
        <p class="text-zinc-500 dark:text-zinc-400 max-sm:text-center">
          {t.home.tryIt}
        </p>
      </div>
    </div>
  </div>
</section>
