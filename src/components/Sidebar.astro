---
import { getLocale, getMessages, localizedPath } from "../i18n";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
---

<aside
  id="logo-sidebar"
  class="fixed top-0 left-0 z-40 h-dvh w-64 -translate-x-full border-r border-brand-100 bg-white pt-20 transition-transform lg:translate-x-0 dark:border-brand-900 dark:bg-[#0b293d]"
  aria-label="Sidebar"
>
  <div class="h-full overflow-y-auto px-3 pb-4 dark:bg-[#0b293d]">
    <ul class="space-y-2 font-medium">
      <li>
        <a
          href={localizedPath(locale, "")}
          class="flex items-center p-2 text-zinc-900 rounded-lg dark:text-white hover:bg-brand-50 dark:hover:bg-brand-900 group"
        >
          <span class="ms-3">{t.tutorial.packName}</span>
        </a>
      </li>
      <li>
        <a
          href="#Prism"
          class="flex items-center p-2 text-zinc-900 rounded-lg dark:text-white hover:bg-brand-50 dark:hover:bg-brand-900 group"
        >
          <span class="flex-1 ms-3 whitespace-nowrap">{t.tutorial.prism}</span>
        </a>
      </li>
      <li>
        <a
          href="#Curseforge"
          class="flex items-center p-2 text-zinc-900 rounded-lg dark:text-white hover:bg-brand-50 dark:hover:bg-brand-900 group"
        >
          <span class="flex-1 ms-3 whitespace-nowrap">{t.tutorial.curseforge}</span>
        </a>
      </li>
      <li>
        <a
          href="#Modrinth"
          class="flex items-center p-2 text-zinc-900 rounded-lg dark:text-white hover:bg-brand-50 dark:hover:bg-brand-900 group"
        >
          <span class="flex-1 ms-3 whitespace-nowrap">{t.tutorial.modrinth}</span>
        </a>
      </li>
    </ul>
  </div>
</aside>
