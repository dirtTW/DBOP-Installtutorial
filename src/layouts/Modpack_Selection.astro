---
import Card from "../components/Card.astro";
import PageIntro from "../components/PageIntro.astro";
import { getLocale, getMessages } from "../i18n";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
---

<main>
  <PageIntro
    eyebrow={t.pages.modpacksEyebrow}
    title={t.nav.modpacks}
    description={t.pages.modpacksDescription}
  />
  <section class="mx-auto max-w-screen-xl px-5 pb-20 sm:px-8 lg:px-10">
    <div class="mb-6 rounded-2xl border border-brand-100 bg-brand-50/70 p-4 dark:border-brand-900 dark:bg-[#0b293d] sm:p-5">
      <div class="max-w-2xl">
        <label for="modpack-search" class="sr-only">
          {t.search.modpacksLabel}
        </label>
        <input
          id="modpack-search"
          type="search"
          placeholder={t.search.modpacksPlaceholder}
          class="block w-full rounded-xl border border-brand-200 bg-white px-4 py-3 text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-brand-800 dark:bg-[#071d2d] dark:text-white dark:placeholder:text-zinc-500"
        />
        <p
          id="modpack-search-status"
          class="mt-3 text-xs font-medium text-zinc-500 dark:text-zinc-400"
          role="status"
          aria-live="polite"
          data-found-template={t.search.foundModpacks}
          data-not-found-template={t.search.noModpacks}
          data-total-template={t.search.totalModpacks}
        ></p>
      </div>
      <div id="modpack-list" class="space-y-3">
          <Card
            locale={locale}
            modrinthId="olssWAmw"
            name={t.modpacks.dbopName}
            altText={t.modpacks.dbopDescription}
            modrinthlink="https://modrinth.com/modpack/dbop"
            curseforgelink="https://www.curseforge.com/minecraft/modpacks/dbop"
          />
          <Card
            locale={locale}
            modrinthId="fT7MQtrV"
            name={t.modpacks.dupName}
            altText={t.modpacks.dupDescription}
            modrinthlink="https://modrinth.com/modpack/dup"
            curseforgelink=""
          />
          <Card
            locale={locale}
            modrinthId="1KVo5zza"
            name="Fabulously Optimized"
            altText={t.modpacks.fabulouslyOptimized}
            modrinthlink="https://modrinth.com/modpack/fabulously-optimized"
            curseforgelink="https://www.curseforge.com/minecraft/modpacks/fabulously-optimized"
          />
          <Card
            locale={locale}
            modrinthId="Ohwb2cTF"
            name="TNVBP"
            altText={t.modpacks.tnvbp}
            modrinthlink="https://modrinth.com/modpack/tnvbp"
            curseforgelink=""
          />
          <Card
            locale={locale}
            modrinthId="Er2bMzL7"
            name="TNVBP Lite"
            altText={t.modpacks.tnvbpLite}
            modrinthlink="https://modrinth.com/modpack/tnvbp-lite"
            curseforgelink=""
          />
          <Card
            locale={locale}
            modrinthId="BYfVnHa7"
            name="Simply Optimized"
            altText={t.modpacks.simplyOptimized}
            modrinthlink="https://modrinth.com/modpack/sop"
            curseforgelink=""
          />
          <Card
            locale={locale}
            modrinthId=""
            modrinthlink=""
            fallbackVersion="1.19.2"
            name="All of Fabric 6 - AOF6"
            altText={t.modpacks.aof6}
            curseforgelink="https://www.curseforge.com/minecraft/modpacks/all-of-fabric-6"
            curseforgeId="695890"
            imageUrl="https://media.forgecdn.net/avatars/thumbnails/630/292/256/256/638029267991555056.png"
          />
          <Card
            locale={locale}
            modrinthId=""
            modrinthlink=""
            fallbackVersion="1.20.1"
            name="All of Fabric 7 - AOF7"
            altText={t.modpacks.aof7}
            curseforgelink="https://www.curseforge.com/minecraft/modpacks/all-of-fabric-7"
            curseforgeId="899572"
            imageUrl="https://media.forgecdn.net/avatars/861/617/638269386500250203.png"
          />
          <Card
            locale={locale}
            modrinthId=""
            modrinthlink=""
            fallbackVersion="1.20.1"
            name="All the Mods 9 - ATM9"
            altText={t.modpacks.atm}
            curseforgelink="https://www.curseforge.com/minecraft/modpacks/all-the-mods-9"
            curseforgeId="715572"
            imageUrl="https://media.forgecdn.net/avatars/902/338/638350403793040080.png"
          />
          <Card
            locale={locale}
            modrinthId=""
            modrinthlink=""
            fallbackVersion="1.21.1"
            name="All the Mods 10 - ATM10"
            altText={t.modpacks.atm}
            curseforgelink="https://www.curseforge.com/minecraft/modpacks/all-the-mods-10"
            curseforgeId="925200"
            imageUrl="https://media.forgecdn.net/avatars/1182/438/638755918649288941.png"
          />
          <Card
            locale={locale}
            modrinthId=""
            modrinthlink=""
            fallbackVersion="1.20.1"
            name="All the Mods 9 - To the Sky"
            altText={t.modpacks.atm9Sky}
            curseforgelink="https://www.curseforge.com/minecraft/modpacks/all-the-mods-9-to-the-sky"
            curseforgeId="967745"
            imageUrl="https://media.forgecdn.net/avatars/thumbnails/999/347/256/256/638518044265918139.png"
          />
          <Card
            locale={locale}
            modrinthId=""
            modrinthlink=""
            fallbackVersion="1.21.1"
            name="Craftoria"
            altText={t.modpacks.craftoria}
            curseforgelink="https://www.curseforge.com/minecraft/modpacks/craftoria"
            curseforgeId="1039252"
            imageUrl="https://media.forgecdn.net/avatars/thumbnails/1066/473/256/256/638600434802547442.png"
          />
      </div>
    </div>
  </section>
</main>

<script>
  const searchInput =
    document.querySelector<HTMLInputElement>("#modpack-search");
  const resultStatus = document.querySelector<HTMLElement>(
    "#modpack-search-status",
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("#modpack-list > article"),
  );

  if (searchInput && resultStatus) {
    const format = (template: string | undefined, placeholder: string, value: string) =>
      (template ?? "").replace(placeholder, value);
    const filterCards = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      for (const card of cards) {
        const isMatch =
          card.textContent?.toLowerCase().includes(query) ?? false;
        card.style.display = isMatch ? "" : "none";
        if (isMatch) visibleCount++;
      }

      resultStatus.textContent = query
        ? visibleCount > 0
          ? format(resultStatus.dataset.foundTemplate, "{count}", String(visibleCount))
          : format(resultStatus.dataset.notFoundTemplate, "{query}", searchInput.value.trim())
        : format(resultStatus.dataset.totalTemplate, "{count}", String(visibleCount));
    };

    searchInput.addEventListener("input", filterCards);
    filterCards();
  }
</script>
