---
import SmallCard from "../components/Small-Card.astro";
---

<main>
  <div class="p-4">
    <div
      class="p-4 border-2 border-zinc-200 rounded-lg dark:border-zinc-700 mt-14"
    >
      <div class="mb-4">
        <label for="useful-website-search" class="sr-only">
          搜尋實用網站
        </label>
        <input
          id="useful-website-search"
          type="search"
          placeholder="搜尋網站名稱或網址..."
          class="block w-full rounded-lg border border-zinc-300 bg-white p-2.5 text-sm text-zinc-900 focus:border-blue-500 focus:ring-blue-500 dark:border-zinc-600 dark:bg-zinc-700 dark:text-white dark:placeholder-zinc-400"
        />
        <p
          id="useful-website-search-status"
          class="mt-2 text-sm text-zinc-600 dark:text-zinc-400"
          role="status"
          aria-live="polite"
        >
        </p>
      </div>
      <div class="flex">
        <div id="useful-website-list" class="grow">
          <SmallCard
            link="https://massgrave.dev/"
            altText="Massgrave (Active Windows)"
          />
          <SmallCard
            link="https://ninite.com/"
            altText="Ninite (Download Software all in one installer)"
          />
          <SmallCard
            link="https://cobalt.tools/"
            altText="Cobalt Tools (Video Download)"
          />
          <SmallCard
            link="https://ytdlp.online/"
            altText="ytdlp (Download Youtube Video/Music)"
          />
          <SmallCard
            link="https://spotidownloader.com/"
            altText="Spotidownloader (Download Spotify Music)"
          />
          <SmallCard
            link="https://wiki.dbzer0.com/genp-guides/"
            altText="GenP Wiki (Active Adobe)"
          />
          <SmallCard
            link="https://tinypng.com/"
            altText="TinyPNG (Compress Image files)"
          />
          <SmallCard
            link="https://gog-games.to/"
            altText="GOG games to (Download Free GOG games)"
          />
          <SmallCard
            link="https://www.yasir252.com/"
            altText="Yasir252 (Software Cracks Download)"
          />
          <SmallCard
            link="https://www.ventoy.net/en/index.html"
            altText="Ventoy (Create Bootable USB)"
          />
          <SmallCard
            link="https://www.7-zip.org/"
            altText="7-Zip (File Compression Tool)"
          />
          <SmallCard
            link="https://www.virustotal.com/gui/home/upload"
            altText="VirusTotal (File Scan)"
          />
          <SmallCard
            link="https://diskanalyzer.com/"
            altText="WizTree Disk Analyzer (Analyze Disk Space Usage)"
          />
          <SmallCard
            link="https://fmhy.net/"
            altText="freemediaheckyeah The largest collection of free stuff on the internet!"
          />
          <SmallCard
            link="https://psutierlist.org/"
            altText="PL's PSU Tier List"
          />
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  const searchInput = document.querySelector<HTMLInputElement>(
    "#useful-website-search",
  );
  const resultStatus = document.querySelector<HTMLElement>(
    "#useful-website-search-status",
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("#useful-website-list > a"),
  );

  if (searchInput && resultStatus) {
    const filterCards = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      for (const card of cards) {
        const searchableText =
          `${card.textContent ?? ""} ${card.href}`.toLowerCase();
        const isMatch = searchableText.includes(query);
        card.style.display = isMatch ? "" : "none";
        if (isMatch) visibleCount++;
      }

      resultStatus.textContent = query
        ? visibleCount > 0
          ? `找到 ${visibleCount} 個網站`
          : `找不到符合「${searchInput.value.trim()}」的網站`
        : `共 ${visibleCount} 個網站`;
    };

    searchInput.addEventListener("input", filterCards);
    filterCards();
  }
</script>
