---
import SmallCard from "../components/Small-Card.astro";
import PageIntro from "../components/PageIntro.astro";
import { getLocale, getMessages } from "../i18n";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
---

<main>
  <PageIntro
    eyebrow={t.pages.softwareEyebrow}
    title={t.nav.usefulSites}
    description={t.pages.softwareDescription}
  />
  <section class="mx-auto max-w-screen-xl px-5 pb-20 sm:px-8 lg:px-10">
    <div class="mb-6 rounded-2xl border border-brand-100 bg-brand-50/70 p-4 dark:border-brand-900 dark:bg-[#0b293d] sm:p-5">
      <div class="max-w-2xl">
        <label for="useful-website-search" class="sr-only">
          {t.search.usefulSitesLabel}
        </label>
        <input
          id="useful-website-search"
          type="search"
          placeholder={t.search.websitesPlaceholder}
          class="block w-full rounded-xl border border-brand-200 bg-white px-4 py-3 text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-brand-800 dark:bg-[#071d2d] dark:text-white dark:placeholder:text-zinc-500"
        />
        <p
          id="useful-website-search-status"
          class="mt-3 text-xs font-medium text-zinc-500 dark:text-zinc-400"
          role="status"
          aria-live="polite"
          data-found-template={t.search.foundWebsites}
          data-not-found-template={t.search.noWebsites}
          data-total-template={t.search.totalWebsites}
        >
        </p>
      </div>
      </div>
      <div id="useful-website-list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <SmallCard
            link="https://massgrave.dev/"
            altText="Massgrave (Active Windows)"
          />
          <SmallCard
            link="https://ninite.com/"
            altText="Ninite (Download Software all in one installer)"
          />
          <SmallCard
            link="https://cobalt.tools/"
            altText="Cobalt Tools (Video Download)"
          />
          <SmallCard
            link="https://ytdlp.online/"
            altText="ytdlp (Download Youtube Video/Music)"
          />
          <SmallCard
            link="https://spotidownloader.com/"
            altText="Spotidownloader (Download Spotify Music)"
          />
          <SmallCard
            link="https://wiki.dbzer0.com/genp-guides/"
            altText="GenP Wiki (Active Adobe)"
          />
          <SmallCard
            link="https://tinypng.com/"
            altText="TinyPNG (Compress Image files)"
          />
          <SmallCard
            link="https://gog-games.to/"
            altText="GOG games to (Download Free GOG games)"
          />
          <SmallCard
            link="https://www.yasir252.com/"
            altText="Yasir252 (Software Cracks Download)"
          />
          <SmallCard
            link="https://www.ventoy.net/en/index.html"
            altText="Ventoy (Create Bootable USB)"
          />
          <SmallCard
            link="https://www.7-zip.org/"
            altText="7-Zip (File Compression Tool)"
          />
          <SmallCard
            link="https://www.virustotal.com/gui/home/upload"
            altText="VirusTotal (File Scan)"
          />
          <SmallCard
            link="https://diskanalyzer.com/"
            altText="WizTree Disk Analyzer (Analyze Disk Space Usage)"
          />
          <SmallCard
            link="https://fmhy.net/"
            altText="freemediaheckyeah The largest collection of free stuff on the internet!"
          />
          <SmallCard
            link="https://psutierlist.org/"
            altText="PL's PSU Tier List"
          />
      </div>
  </section>
</main>

<script>
  const searchInput = document.querySelector<HTMLInputElement>(
    "#useful-website-search",
  );
  const resultStatus = document.querySelector<HTMLElement>(
    "#useful-website-search-status",
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("#useful-website-list > a"),
  );

  if (searchInput && resultStatus) {
    const format = (template: string | undefined, placeholder: string, value: string) =>
      (template ?? "").replace(placeholder, value);
    const filterCards = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      for (const card of cards) {
        const searchableText =
          `${card.textContent ?? ""} ${card.href}`.toLowerCase();
        const isMatch = searchableText.includes(query);
        card.style.display = isMatch ? "" : "none";
        if (isMatch) visibleCount++;
      }

      resultStatus.textContent = query
        ? visibleCount > 0
          ? format(resultStatus.dataset.foundTemplate, "{count}", String(visibleCount))
          : format(resultStatus.dataset.notFoundTemplate, "{query}", searchInput.value.trim())
        : format(resultStatus.dataset.totalTemplate, "{count}", String(visibleCount));
    };

    searchInput.addEventListener("input", filterCards);
    filterCards();
  }
</script>
