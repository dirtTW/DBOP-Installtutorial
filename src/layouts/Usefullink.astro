---
import WebsiteDirectory from "../components/WebsiteDirectory.astro";
import PageIntro from "../components/PageIntro.astro";
import { getLocale, getMessages } from "../i18n";
import usefulWebsitesMarkdown from "../../lists/useful-websites.md?raw";
import { parseWebsiteLinks } from "../lib/website-links";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
const websites = parseWebsiteLinks(usefulWebsitesMarkdown);
---

<main>
  <PageIntro
    eyebrow={t.pages.softwareEyebrow}
    title={t.nav.usefulSites}
    description={t.pages.softwareDescription}
  />
  <WebsiteDirectory
    websites={websites}
    locale={locale}
    searchId="useful-website-search"
    listId="useful-website-list"
    searchLabel={t.search.websitesLabel}
    searchPlaceholder={t.search.websitesPlaceholder}
    foundTemplate={t.search.foundWebsites}
    notFoundTemplate={t.search.noWebsites}
    totalTemplate={t.search.totalWebsites}
    filterLabel={t.filters.label}
    allLabel={t.filters.all}
    noResultsLabel={t.filters.noResults}
    categoryLabels={t.filters.categories}
  />
</main>
