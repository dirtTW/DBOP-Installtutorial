---
import PageIntro from "../components/PageIntro.astro";
import { getLocale, getMessages } from "../i18n";
import logo from "../img/logo.webp";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
const launchers = [
  {
    id: "Prism",
    name: t.tutorial.prism,
    href: "https://prismlauncher.org/download/",
    steps: t.tutorial.prismSteps,
  },
  {
    id: "Curseforge",
    name: t.tutorial.curseforge,
    href: "https://www.curseforge.com/download/app#download-options",
    steps: t.tutorial.curseforgeSteps,
  },
  {
    id: "Modrinth",
    name: t.tutorial.modrinth,
    href: "https://modrinth.com/app",
    steps: t.tutorial.modrinthSteps,
  },
];
---

<main>
  <PageIntro
    eyebrow={t.pages.installEyebrow}
    title={t.tutorial.title}
    description={t.pages.installDescription}
  />
  <div class="mx-auto max-w-screen-xl px-5 pb-20 sm:px-8 lg:px-10">
    <section class="relative overflow-hidden rounded-3xl bg-zinc-950 p-6 text-white shadow-xl shadow-zinc-950/10 sm:p-9">
      <div aria-hidden="true" class="absolute -right-20 -top-32 h-80 w-80 rounded-full bg-emerald-500/20 blur-3xl"></div>
      <div class="relative flex flex-col gap-7 md:flex-row md:items-center md:justify-between">
        <div class="flex items-center gap-5">
          <img src={logo.src} alt="" width="96" height="96" class="h-20 w-20 shrink-0 rounded-2xl object-cover shadow-lg sm:h-24 sm:w-24" />
          <div>
            <p class="mb-1 text-xs font-bold uppercase tracking-[0.18em] text-emerald-300">{t.home.packLabel}</p>
            <h2 class="max-w-xl text-xl font-bold leading-tight sm:text-2xl">{t.tutorial.packName}</h2>
          </div>
        </div>
        <div class="flex flex-col gap-3 md:flex-row">
          <a
            href="https://modrinth.com/modpack/dbop"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-emerald-400 px-4 py-3 text-sm font-bold text-zinc-950 transition hover:bg-emerald-300 focus:outline-none focus:ring-2 focus:ring-emerald-200"
          >
            <i class="md-logo" aria-hidden="true"></i>
            {t.cards.downloadModrinth}
          </a>
          <a
            href="https://www.curseforge.com/minecraft/modpacks/dbop"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-orange-500 px-4 py-3 text-sm font-bold text-white transition hover:bg-orange-400 focus:outline-none focus:ring-2 focus:ring-orange-200"
          >
            <i class="cf-logo" aria-hidden="true"></i>
            {t.cards.downloadCurseforge}
          </a>
        </div>
      </div>
    </section>

    <nav aria-label={t.tutorial.install} class="mt-8 flex flex-wrap gap-2">
      {launchers.map(({ id, name }) => (
        <a href={`#${id}`} class="rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-semibold text-zinc-700 transition hover:border-emerald-800/30 hover:bg-emerald-50 hover:text-emerald-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-emerald-300/30 dark:hover:bg-emerald-300/10 dark:hover:text-emerald-200">
          {name}
        </a>
      ))}
    </nav>

    <section class="mt-10 rounded-2xl border border-emerald-900/10 bg-emerald-50/70 p-5 dark:border-emerald-200/10 dark:bg-emerald-400/5 sm:p-6">
      <h2 class="text-lg font-bold text-zinc-900 dark:text-white">{t.tutorial.javaHeading}</h2>
      <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{t.tutorial.javaDescription}</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {[
          { minecraft: "1.8+", java: "8", version: "8" },
          { minecraft: "1.16+", java: "17", version: "17" },
          { minecraft: "1.20.5+", java: "21", version: "21" },
        ].map(({ minecraft, java, version }) => (
          <a
            class="rounded-xl border border-zinc-200 bg-white px-4 py-3 transition hover:border-emerald-700/30 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-emerald-300/30"
            href={`https://adoptium.net/temurin/releases/?version=${version}&package=jre&arch=x64`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="block text-xs font-semibold text-zinc-500 dark:text-zinc-400">Minecraft {minecraft}</span>
            <span class="mt-1 block font-bold text-emerald-800 dark:text-emerald-300">Java {java} <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </section>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {launchers.map(({ id, name, href, steps }, index) => (
        <section id={id} class="scroll-mt-24 rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 sm:p-6">
          <div class="mb-5 flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-900/5 text-sm font-bold text-emerald-800 dark:bg-emerald-300/10 dark:text-emerald-300">{index + 1}</span>
            <h2 class="text-lg font-bold text-zinc-900 dark:text-white">{name}</h2>
          </div>
          <a href={href} target="_blank" rel="noopener noreferrer" class="mb-5 inline-flex items-center gap-1 text-sm font-semibold text-emerald-800 hover:underline dark:text-emerald-300">
            {t.tutorial.downloadLauncher}
            <span aria-hidden="true">↗</span>
          </a>
          <ol class="space-y-3">
            {steps.map((step) => (
              <li class="flex gap-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
                <span aria-hidden="true" class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-[10px] font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">✓</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</main>
