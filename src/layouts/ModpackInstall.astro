---
import { getLocale, getMessages } from "../i18n";

const t = getMessages(getLocale(Astro.props.locale ?? Astro.currentLocale));
---

<main>
  <div class="p-4 lg:ml-64">
    <div class="p-4 border-2 border-zinc-200 rounded-lg dark:border-zinc-700 mt-14">
      <img
        fetchpriority="high"
        src="https://github.com/dirttw/DBOP/blob/main/banner.png?raw=true"
        alt="DBOP Banner"
        width="1100"
        class="shadow rounded mx-auto"
      />
      <div class="py-4 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
        <div class="max-w-screen-md mb-8 lg:mb-16">
          <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-zinc-900 dark:text-white">
            {t.tutorial.packName}
          </h2>
        </div>
        <div class="flex flex-auto">
          <a
            class="text-sm text-center focus:outline-none text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:ring-green-300 font-medium rounded-lg px-5 py-2.5 me-2 mb-2 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800"
            href="https://modrinth.com/modpack/dbop"
            target="_blank"
          >
            <span>
              <i class="md-logo w-4 h-4 me-2 ms-1" aria-hidden="true"></i>
            </span>{" "}
            {t.cards.downloadModrinth}
          </a>
          <a
            class="text-sm text-center focus:outline-none text-white bg-orange-600 hover:bg-orange-700 focus:ring-4 focus:ring-orange-600 font-medium rounded-lg px-5 py-2.5 me-2 mb-2 dark:focus:ring-yellow-900"
            href="https://www.curseforge.com/minecraft/modpacks/dbop"
            target="_blank"
          >
            <span>
              <i class="cf-logo w-4 h-4 me-2 ms-1" aria-hidden="true"></i>
            </span>{" "}
            {t.cards.downloadCurseforge}
          </a>
        </div>

        <h2
          class="m-6 text-xl font-extrabold text-zinc-900 dark:text-white"
          id="installtutorial"
        >
          <br />
          {t.tutorial.install}
        </h2>
        <div class="">
          <ul class="space-y-2 text-zinc-500 list-disc list-inside dark:text-zinc-400">
            <li>
              <a
                id="Prism"
                class="font-medium text-blue-600 dark:text-blue-500 hover:underline text-xl"
                href="https://prismlauncher.org/download/"
              >
                {t.tutorial.prism}
              </a>
              <span>
                <a
                  class="hover:underline text-xl"
                  href="#Prism"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  #
                </a>
              </span>
              <ol class="ps-5 mt-2 space-y-1 list-decimal list-inside">
                <p>
                  {t.tutorial.needJava("8", "1.8+")}{" "}
                  <a
                    class="font-medium text-blue-600 dark:text-blue-500 hover:underline"
                    href="https://adoptium.net/temurin/releases/?version=8&package=jre&arch=x64"
                  >
                    Java 8
                  </a>{" "}
                </p>
                <p>
                  {t.tutorial.needJava("17", "1.16+")}{" "}
                  <a
                    class="font-medium text-blue-600 dark:text-blue-500 hover:underline"
                    href="https://adoptium.net/temurin/releases/?version=17&package=jre&arch=x64"
                  >
                    Java 17
                  </a>{" "}
                </p>
                <p>
                  {t.tutorial.needJava("21", "1.20.5+")}{" "}
                  <a
                    class="font-medium text-blue-600 dark:text-blue-500 hover:underline"
                    href="https://adoptium.net/temurin/releases/?version=21&package=jre&arch=x64"
                  >
                    Java 21
                  </a>{" "}
                </p>
                {t.tutorial.prismSteps.map((step) => <li>{step}</li>)}
              </ol>
            </li>
            <br />
            <li>
              <a
                id="Curseforge"
                class="font-medium text-blue-600 dark:text-blue-500 hover:underline text-xl"
                href="https://www.curseforge.com/download/app#download-options"
              >
                {t.tutorial.curseforge}
              </a>
              <span>
                <a
                  class="hover:underline text-xl"
                  href="#Curseforge"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  #
                </a>
              </span>
              <ul class="ps-5 mt-2 space-y-1 list-decimal list-inside">
                {t.tutorial.curseforgeSteps.map((step) => <li>{step}</li>)}
              </ul>
            </li>
            <br />
            <li>
              <a
                id="Modrinth"
                class="font-medium text-blue-600 dark:text-blue-500 hover:underline text-xl"
                href="https://modrinth.com/app"
              >
                {t.tutorial.modrinth}
              </a>
              <span>
                <a
                  class="hover:underline text-xl"
                  href="#Modrinth"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  #
                </a>
              </span>
              <ul class="ps-5 mt-2 space-y-1 list-decimal list-inside">
                {t.tutorial.modrinthSteps.map((step) => <li>{step}</li>)}
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</main>
