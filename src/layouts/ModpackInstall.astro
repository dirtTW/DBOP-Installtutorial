---
import PageIntro from "../components/PageIntro.astro";
import { Image } from "astro:assets";
import { getLocale, getMessages } from "../i18n";
import logo from "../img/logo.webp";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
const launchers = [
  {
    id: "Prism",
    name: t.tutorial.prism,
    href: "https://prismlauncher.org/download/",
    steps: t.tutorial.prismSteps,
  },
  {
    id: "Curseforge",
    name: t.tutorial.curseforge,
    href: "https://www.curseforge.com/download/app#download-options",
    steps: t.tutorial.curseforgeSteps,
  },
  {
    id: "Modrinth",
    name: t.tutorial.modrinth,
    href: "https://modrinth.com/app",
    steps: t.tutorial.modrinthSteps,
  },
];
---

<main>
  <PageIntro
    eyebrow={t.pages.installEyebrow}
    title={t.tutorial.title}
    description={t.pages.installDescription}
  />
  <div class="mx-auto max-w-screen-xl px-5 pb-20 sm:px-8 lg:px-10">
    <section class="relative overflow-hidden rounded-[1.75rem] bg-[var(--m3-primary-container)] p-6 text-[var(--m3-on-primary-container)] sm:p-9">
      <div aria-hidden="true" class="absolute -right-20 -top-32 h-80 w-80 rounded-full bg-[var(--m3-primary)] opacity-15 blur-3xl"></div>
      <div class="relative flex flex-col gap-7 md:flex-row md:items-center md:justify-between">
        <div class="flex items-center gap-5">
          <Image src={logo} alt="" width={96} height={96} format="webp" class="h-20 w-20 shrink-0 rounded-2xl object-cover sm:h-24 sm:w-24" />
          <div>
            <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--m3-primary)]">{t.home.packLabel}</p>
            <h2 class="max-w-xl text-xl font-medium leading-tight sm:text-2xl">{t.tutorial.packName}</h2>
          </div>
        </div>
        <div class="flex flex-col gap-3 md:flex-row">
          <a
            href="https://modrinth.com/modpack/dbop"
            target="_blank"
            rel="noopener noreferrer"
            class="md3-btn btn-modrinth min-h-12 gap-2 px-5 font-semibold"
          >
            <i class="md-logo" aria-hidden="true"></i>
            {t.cards.downloadModrinth}
          </a>
          <a
            href="https://www.curseforge.com/minecraft/modpacks/dbop"
            target="_blank"
            rel="noopener noreferrer"
            class="md3-btn btn-curseforge min-h-12 gap-2 px-5 font-semibold"
          >
            <i class="cf-logo" aria-hidden="true"></i>
            {t.cards.downloadCurseforge}
          </a>
        </div>
      </div>
    </section>

    <nav aria-label={t.tutorial.install} class="mt-8 flex flex-wrap gap-2">
      {launchers.map(({ id, name }) => (
        <a href={`#${id}`} class="md3-chip">
          {name}
        </a>
      ))}
    </nav>

    <section class="md3-card mt-10 p-5 sm:p-6">
      <h2 class="md3-title">
        {t.tutorial.javaHeading}
      </h2>
      <p class="md3-body-sm mt-1">
        {t.tutorial.javaDescription}
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {[
          { minecraft: "1.8+", java: "8", version: "8" },
          { minecraft: "1.16+", java: "17", version: "17" },
          { minecraft: "1.20.5+", java: "21", version: "21" },
        ].map(({ minecraft, java, version }) => (
          <a
            class="java-card rounded-xl bg-[var(--m3-surface-container-lowest)] px-4 py-3"
            href={`https://adoptium.net/temurin/releases/?version=${version}&package=jre&arch=x64`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="block text-xs font-medium text-[var(--m3-on-surface-variant)]">Minecraft {minecraft}</span>
            <span class="mt-1 block font-medium text-[var(--m3-primary)]">Java {java} <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </section>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {launchers.map(({ id, name, href, steps }, index) => (
        <section id={id} class="md3-card scroll-mt-24 p-5 sm:p-6">
          <div class="mb-5 flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[var(--m3-secondary-container)] text-sm font-semibold text-[var(--m3-on-secondary-container)]">{index + 1}</span>
            <h2 class="md3-title">{name}</h2>
          </div>
          <a href={href} target="_blank" rel="noopener noreferrer" class:list={[
            "mb-5 inline-flex items-center gap-1 text-sm font-medium hover:underline",
            id === "Modrinth"
              ? "text-[#12833f] dark:text-[#1bd96a]"
              : id === "Curseforge"
                ? "text-[#d94d24] dark:text-[#ff8a65]"
                : "text-[var(--m3-primary)]",
          ]}>
            {t.tutorial.downloadLauncher}
            <span aria-hidden="true">↗</span>
          </a>
          <ol class="space-y-3">
            {steps.map((step) => (
              <li class="md3-body-sm flex gap-3">
                <span aria-hidden="true" class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[var(--m3-secondary-container)] text-[10px] font-semibold text-[var(--m3-on-secondary-container)]">✓</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</main>

<style>
  .btn-modrinth {
    background-color: #1bd96a;
    color: #102217;
  }

  .btn-modrinth:hover {
    background-color: #16c45d;
  }

  .btn-curseforge {
    background-color: #f16436;
    color: #ffffff;
  }

  .btn-curseforge:hover {
    background-color: #db5128;
  }

  .java-card {
    transition: background-color 180ms var(--m3-easing);
  }

  .java-card:hover {
    background-color: var(--m3-surface-container-high);
  }
</style>
