---
import WebsiteDirectory from "../components/WebsiteDirectory.astro";
import PageIntro from "../components/PageIntro.astro";
import { getLocale, getMessages } from "../i18n";
import minecraftWebsitesMarkdown from "../../lists/minecraft-useful-websites.md?raw";
import { parseWebsiteLinks } from "../lib/website-links";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
const websites = parseWebsiteLinks(minecraftWebsitesMarkdown);
---

<main>
  <PageIntro
    eyebrow={t.pages.minecraftEyebrow}
    title={t.nav.minecraftSites}
    description={t.pages.minecraftDescription}
  />
  <WebsiteDirectory
    websites={websites}
    locale={locale}
    searchId="minecraft-website-search"
    listId="minecraft-website-list"
    searchLabel={t.search.minecraftSitesLabel}
    searchPlaceholder={t.search.websitesPlaceholder}
    foundTemplate={t.search.foundWebsites}
    notFoundTemplate={t.search.noWebsites}
    totalTemplate={t.search.totalWebsites}
  />
</main>
