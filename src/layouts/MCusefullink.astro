---
import SmallCard from "../components/Small-Card.astro";
import PageIntro from "../components/PageIntro.astro";
import { getLocale, getMessages } from "../i18n";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
---

<main>
  <PageIntro
    eyebrow={t.pages.minecraftEyebrow}
    title={t.nav.minecraftSites}
    description={t.pages.minecraftDescription}
  />
  <section class="mx-auto max-w-screen-xl px-5 pb-20 sm:px-8 lg:px-10">
    <div class="mb-6 rounded-2xl border border-brand-100 bg-brand-50/70 p-4 dark:border-brand-900 dark:bg-[#0b293d] sm:p-5">
      <div class="max-w-2xl">
        <label for="minecraft-website-search" class="sr-only">
          {t.search.minecraftSitesLabel}
        </label>
        <input
          id="minecraft-website-search"
          type="search"
          placeholder={t.search.websitesPlaceholder}
          class="block w-full rounded-xl border border-brand-200 bg-white px-4 py-3 text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-brand-800 dark:bg-[#071d2d] dark:text-white dark:placeholder:text-zinc-500"
        />
        <p
          id="minecraft-website-search-status"
          class="mt-3 text-xs font-medium text-zinc-500 dark:text-zinc-400"
          role="status"
          aria-live="polite"
          data-found-template={t.search.foundWebsites}
          data-not-found-template={t.search.noWebsites}
          data-total-template={t.search.totalWebsites}
        ></p>
      </div>
      </div>
      <div id="minecraft-website-list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <SmallCard
            link="https://www.minecraft.net/zh-hant"
            altText="Minecraft 官方"
          />
          <SmallCard
            link="https://www.minecraft.net/zh-hant/download"
            altText="Minecraft 官方啟動器下載"
          />
          <SmallCard
            link="https://zh.minecraft.wiki/w/Minecraft_Wiki"
            altText="Minecraft 官方維基 Wiki"
          />
          <SmallCard
            link="https://johann.loefflmann.net/en/software/jarfix/index.html"
            altText="Jarfix 修復 .jar 開啟使用 java"
          />
          <SmallCard
            link="https://fabricmc.net/use"
            altText="Fabric 模組平台 官網"
          />
          <SmallCard
            link="https://quiltmc.org/en/"
            altText="Quilt 模組平台 官網"
          />
          <SmallCard
            link="https://neoforged.net/"
            altText="NeoForge 模組平台 官網"
          />
          <SmallCard
            link="https://files.minecraftforge.net/net/minecraftforge/forge/"
            altText="Forge 模組平台 官網"
          />
          <SmallCard
            link="https://modrinth.com/"
            altText="Modrinth Minecraft 資源下載"
          />
          <SmallCard
            link="https://www.curseforge.com/minecraft"
            altText="Curseforge Minecraft 資源下載"
          />
          <SmallCard
            link="https://flags.sh/"
            altText="Flasg.sh 方便生成開服指令"
          />
          <SmallCard
            link="https://mclo.gs/"
            altText="Mclo.gs 方便上傳跟查看崩潰記錄"
          />
          <SmallCard
            link="https://papermc.io/"
            altText="PaperMC 開服平台 官網"
          />
          <SmallCard
            link="https://www.spigotmc.org/"
            altText="Spigot 開服平台 官網"
          />
          <SmallCard
            link="https://purpurmc.org/"
            altText="Purpur 開服平台 官網"
          />
          <SmallCard
            link="https://www.minecraft.net/zh-hant/download/server/bedrock"
            altText="Minecraft 基岩版開服官網"
          />
          <SmallCard
            link="https://prismlauncher.org/"
            altText="Prism 啟動器 好用的模組管理啟動器"
          />
          <SmallCard
            link="https://multimc.org/"
            altText="MultiMC 啟動器 模組管理啟動器"
          />
          <SmallCard
            link="https://www.curseforge.com/download/app"
            altText="Curseforge 啟動器 模組管理啟動器"
          />
          <SmallCard
            link="https://gdlauncher.com/"
            altText="GDlauncher 啟動器 模組管理啟動器"
          />
          <SmallCard
            link="https://namemc.com/"
            altText="NameMC 搜尋玩家名字以及皮膚"
          />
          <SmallCard
