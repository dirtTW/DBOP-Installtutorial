---
import { getLocale, getMessages, localizedPath } from "../i18n";
import logo from "../img/logo.webp";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
---

<main class="overflow-hidden">
  <section class="relative isolate bg-[#f3f8fb] pt-24 dark:bg-[#071d2d] sm:pt-28">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-36 -top-32 -z-10 h-[34rem] w-[34rem] rounded-full bg-brand-200/50 blur-3xl dark:bg-brand-700/20"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-48 -left-40 -z-10 h-[30rem] w-[30rem] rounded-full bg-brand-100/70 blur-3xl dark:bg-brand-800/10"
    ></div>

    <div class="mx-auto grid max-w-screen-xl items-center gap-12 px-5 pb-20 pt-10 sm:px-8 sm:pb-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:px-10 lg:pb-32 lg:pt-14">
      <div class="max-w-2xl">
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-900/10 bg-white/80 px-3.5 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-brand-900 shadow-sm dark:border-brand-200/10 dark:bg-[#0b293d]/80 dark:text-brand-200">
          <span class="h-2 w-2 rounded-full bg-brand-500"></span>
          {t.home.eyebrow}
        </p>
        <h1 class="max-w-xl text-5xl font-black tracking-[-0.055em] text-zinc-950 sm:text-6xl lg:text-7xl dark:text-white">
          {t.home.title}<span class="text-brand-700 dark:text-brand-400">.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-zinc-600 sm:text-xl dark:text-zinc-300">
          {t.home.description}
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={localizedPath(locale, "dbop-install-tutorial")}
            class="group inline-flex min-h-13 items-center justify-center gap-3 rounded-xl bg-brand-700 px-6 py-3.5 font-semibold text-white shadow-lg shadow-brand-950/15 transition hover:-translate-y-0.5 hover:bg-brand-600 focus:outline-none focus:ring-4 focus:ring-brand-500/30 dark:bg-brand-400 dark:text-[#071d2d] dark:hover:bg-brand-300"
          >
            {t.home.install}
            <svg aria-hidden="true" class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10m0 0L8.5 3.5M13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href="#learnmore"
            class="inline-flex min-h-13 items-center justify-center rounded-xl border border-brand-200 bg-white/70 px-6 py-3.5 font-semibold text-zinc-800 transition hover:border-brand-400 hover:bg-white focus:outline-none focus:ring-4 focus:ring-brand-300/50 dark:border-brand-800 dark:bg-[#0b293d]/70 dark:text-zinc-100 dark:hover:border-brand-600 dark:hover:bg-[#0b293d]"
          >
            {t.home.learnMore}
          </a>
        </div>

        <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3 border-t border-zinc-900/10 pt-5 text-sm font-medium text-zinc-600 dark:border-white/10 dark:text-zinc-400">
          <span class="inline-flex items-center gap-2">
            <svg aria-hidden="true" class="h-4 w-4 text-brand-700 dark:text-brand-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.1 7.16a1 1 0 0 1-1.42.003l-3.9-3.9a1 1 0 0 1 1.414-1.414l3.19 3.19 6.393-6.447a1 1 0 0 1 1.417-.006Z" clip-rule="evenodd"></path></svg>
            {t.home.clientSide}
          </span>
          <span class="inline-flex items-center gap-2">
            <svg aria-hidden="true" class="h-4 w-4 text-brand-700 dark:text-brand-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.1 7.16a1 1 0 0 1-1.42.003l-3.9-3.9a1 1 0 0 1 1.414-1.414l3.19 3.19 6.393-6.447a1 1 0 0 1 1.417-.006Z" clip-rule="evenodd"></path></svg>
            {t.home.performance}
          </span>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
        <div aria-hidden="true" class="absolute inset-8 rounded-[2.5rem] bg-brand-700/10 blur-2xl dark:bg-brand-400/10"></div>
        <div class="relative overflow-hidden rounded-[2rem] border border-white/80 bg-white/75 p-5 shadow-[0_30px_90px_-35px_rgba(7,29,45,0.35)] backdrop-blur-xl dark:border-white/10 dark:bg-[#0b293d]/80 sm:p-7">
          <div class="flex items-center justify-between border-b border-zinc-900/10 pb-4 dark:border-white/10">
            <div class="flex items-center gap-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-brand-500"></span>
              <span class="text-xs font-bold uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400">{t.home.packLabel}</span>
            </div>
            <span class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-900 dark:bg-brand-400/10 dark:text-brand-300">{t.home.readyToPlay}</span>
          </div>
          <div class="relative flex min-h-64 items-center justify-center py-5 sm:min-h-80">
            <div aria-hidden="true" class="absolute h-52 w-52 rounded-full border border-brand-900/10 dark:border-brand-100/10 sm:h-64 sm:w-64"></div>
            <div aria-hidden="true" class="absolute h-40 w-40 rounded-full bg-brand-100/80 blur-xl dark:bg-brand-500/10 sm:h-52 sm:w-52"></div>
            <img
              fetchpriority="high"
              src={logo.src}
              alt="DBOP"
              width="225"
              height="225"
              class="relative z-10 h-40 w-40 object-contain drop-shadow-2xl sm:h-48 sm:w-48"
            />
            <span class="absolute right-0 top-2 z-20 rounded-xl border border-brand-100 bg-white/95 px-3 py-2 text-xs font-semibold text-zinc-700 shadow-lg dark:border-brand-800 dark:bg-[#12344c]/95 dark:text-zinc-200 sm:right-4 sm:top-4">{t.home.shaders}</span>
            <span class="absolute bottom-2 left-0 z-20 rounded-xl border border-brand-100 bg-white/95 px-3 py-2 text-xs font-semibold text-zinc-700 shadow-lg dark:border-brand-800 dark:bg-[#12344c]/95 dark:text-zinc-200 sm:bottom-4 sm:left-4">{t.home.stability}</span>
          </div>
          <div class="grid grid-cols-3 gap-2 border-t border-zinc-900/10 pt-4 dark:border-white/10">
            {[t.home.performanceTag, t.home.visualsTag, t.home.qualityTag].map((tag) => (
              <div class="rounded-lg bg-brand-50 px-2 py-2.5 text-center text-[10px] font-bold uppercase tracking-wider text-brand-800 dark:bg-[#12344c] dark:text-brand-200 sm:text-xs">
                {tag}
              </div>
            ))}
          </div>
        </div>
        <div aria-hidden="true" class="absolute -bottom-4 -right-3 -z-10 h-24 w-24 rounded-[1.5rem] border border-brand-900/15 dark:border-brand-200/15"></div>
      </div>
    </div>
  </section>
</main>
