---
import { getLocale, getMessages, localizedPath } from "../i18n";
import { Image } from "astro:assets";
import logo from "../img/logo.webp";

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getMessages(locale);
---

<main class="overflow-hidden">
  <section class="relative isolate pt-24 sm:pt-28">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-36 -top-32 -z-10 h-[34rem] w-[34rem] rounded-full bg-[var(--md-sys-color-primary-container)] opacity-50 blur-3xl dark:opacity-25"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-48 -left-40 -z-10 h-[30rem] w-[30rem] rounded-full bg-[var(--md-sys-color-secondary-container)] opacity-60 blur-3xl dark:opacity-30"
    ></div>

    <div class="mx-auto grid max-w-screen-xl items-center gap-12 px-5 pb-20 pt-10 sm:px-8 sm:pb-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:px-10 lg:pb-32 lg:pt-14">
      <div class="max-w-2xl">
        <p class="mb-6 inline-flex items-center gap-2 rounded-full bg-[var(--md-sys-color-primary-container)] px-4 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-[var(--md-sys-color-on-primary-container)]">
          <span class="h-2 w-2 rounded-full bg-[var(--md-sys-color-primary)]"></span>
          {t.home.eyebrow}
        </p>
        <h1 class="max-w-xl text-[clamp(2.25rem,6vw,3.75rem)] font-medium leading-[1.05] tracking-[-0.02em]">
          {t.home.title}<span class="text-[var(--md-sys-color-primary)]">.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-7 text-[var(--md-sys-color-on-surface-variant)]">
          {t.home.description}
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <md-filled-button
            href={localizedPath(locale, "dbop-install-tutorial")}
            class="shrink-0 [--md-filled-button-container-height:3rem] [--md-filled-button-leading-space:1.5rem] [--md-filled-button-trailing-space:1.5rem]"
          >
            {t.home.install}
          </md-filled-button>
          <md-filled-tonal-button
            href="#learnmore"
            class="shrink-0 [--md-filled-tonal-button-container-height:3rem] [--md-filled-tonal-button-leading-space:1.5rem] [--md-filled-tonal-button-trailing-space:1.5rem]"
          >
            {t.home.learnMore}
          </md-filled-tonal-button>
        </div>

        <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3 border-t border-[var(--md-sys-color-outline-variant)] pt-5 text-sm font-medium text-[var(--md-sys-color-on-surface-variant)]">
          <span class="inline-flex items-center gap-2">
            <span class="material-symbols-outlined text-xl text-[var(--md-sys-color-primary)]" aria-hidden="true">check</span>
            {t.home.clientSide}
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="material-symbols-outlined text-xl text-[var(--md-sys-color-primary)]" aria-hidden="true">check</span>
            {t.home.performance}
          </span>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
        <div aria-hidden="true" class="absolute inset-8 rounded-[2.5rem] bg-[var(--md-sys-color-primary)] opacity-10 blur-2xl"></div>
        <div class="surface-card relative overflow-hidden p-5 sm:p-7">
          <div class="flex items-center justify-between border-b border-[var(--md-sys-color-outline-variant)] pb-4">
            <div class="flex items-center gap-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[var(--md-sys-color-primary)]"></span>
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--md-sys-color-on-surface-variant)]">{t.home.packLabel}</span>
            </div>
            <span class="rounded-full bg-[var(--md-sys-color-secondary-container)] px-3 py-1 text-xs font-semibold text-[var(--md-sys-color-on-secondary-container)]">{t.home.readyToPlay}</span>
          </div>
          <div class="relative flex min-h-64 items-center justify-center py-5 sm:min-h-80">
            <div aria-hidden="true" class="absolute h-52 w-52 rounded-full border border-[var(--md-sys-color-outline-variant)] sm:h-64 sm:w-64"></div>
            <div aria-hidden="true" class="absolute h-40 w-40 rounded-full bg-[var(--md-sys-color-primary-container)] opacity-70 blur-xl dark:opacity-40 sm:h-52 sm:w-52"></div>
            <Image
              fetchpriority="high"
              src={logo}
              alt="DBOP"
              width="225"
              height="225"
              format="webp"
              loading="eager"
              class="relative z-10 h-40 w-40 object-contain drop-shadow-2xl sm:h-48 sm:w-48"
            />
            <span class="absolute right-0 top-2 z-20 rounded-2xl bg-[var(--md-sys-color-surface-container-high)] px-3 py-2 text-xs font-semibold text-[var(--md-sys-color-on-surface)] shadow-md sm:right-4 sm:top-4">{t.home.shaders}</span>
            <span class="absolute bottom-2 left-0 z-20 rounded-2xl bg-[var(--md-sys-color-surface-container-high)] px-3 py-2 text-xs font-semibold text-[var(--md-sys-color-on-surface)] shadow-md sm:bottom-4 sm:left-4">{t.home.stability}</span>
          </div>
          <div class="grid grid-cols-3 gap-2 border-t border-[var(--md-sys-color-outline-variant)] pt-4">
            {[t.home.performanceTag, t.home.visualsTag, t.home.qualityTag].map((tag) => (
              <div class="rounded-xl bg-[var(--md-sys-color-surface-container-high)] px-2 py-2.5 text-center text-[10px] font-semibold uppercase tracking-wider text-[var(--md-sys-color-on-surface-variant)] sm:text-xs">
                {tag}
              </div>
            ))}
          </div>
        </div>
        <div aria-hidden="true" class="absolute -bottom-4 -right-3 -z-10 h-24 w-24 rounded-[1.5rem] border border-[var(--md-sys-color-outline-variant)]"></div>
      </div>
    </div>
  </section>
</main>

<script>
  import "@material/web/button/filled-button.js";
  import "@material/web/button/filled-tonal-button.js";
</script>
