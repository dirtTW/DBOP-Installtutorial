---
import { getLocale, getMessages } from "../i18n";
import favicon from "../favicon.svg";

export interface Props {
  title: string;
  locale?: string;
  /** DOM id of the page's <main>, used by the skip link and the
      view-transition render block. */
  mainId?: string;
}
const { title, locale: localeProp, mainId = "main-content" } = Astro.props;
const locale = getLocale(localeProp);
const t = getMessages(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content={t.description}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <!-- Declares the schemes the site supports. `light dark` follows the OS;
         the inline script below may pin it from localStorage before first
         paint, and global.css maps the value onto `color-scheme`. -->
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") {
          document.querySelector('meta[name="color-scheme"]').content = stored;
        }
      } catch {}
    </script>
    <meta name="theme-color" content="#f9f9ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111318" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="sitemap" href="/sitemap-0.xml" />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Cross-document view transitions may not start until the incoming
         page's main content has been parsed, so the cross-fade never reveals
         a blank page. Ignored by browsers without view transitions. -->
    <link rel="expect" href={`#${mainId}`} blocking="render" />
  </head>
  <body class="flex min-h-screen flex-col bg-[var(--md-sys-color-surface)] text-[var(--md-sys-color-on-surface)]">
    <a class="skip-link" href={`#${mainId}`}>{t.skipToContent}</a>
    <slot />
    <script>
      const schemeMeta = document.querySelector<HTMLMetaElement>(
        'meta[name="color-scheme"]',
      );
      const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const systemScheme = () => (darkQuery.matches ? "dark" : "light");
      const storedScheme = () => {
        try {
          const value = localStorage.getItem("theme");
          return value === "light" || value === "dark" ? value : null;
        } catch {
          return null;
        }
      };
      const renderedScheme = () => storedScheme() ?? systemScheme();

      let themeTransitionTimeout: number | undefined;

      const syncThemeControls = () => {
        const isDark = renderedScheme() === "dark";
        document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((button) => {
          button.toggleAttribute("selected", isDark);
          button.setAttribute(
            "aria-label",
            isDark ? button.dataset.lightLabel ?? "" : button.dataset.darkLabel ?? "",
          );
        });
      };

      const applyScheme = (scheme: string | null) => {
        if (schemeMeta) schemeMeta.content = scheme ?? "light dark";
        syncThemeControls();
      };

      document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const target = renderedScheme() === "dark" ? "light" : "dark";
          document.documentElement.classList.add("theme-transition");
          try {
            // Choosing the scheme the OS already uses is how the user gets
            // back to "follow the system", so drop the override instead.
            if (target === systemScheme()) localStorage.removeItem("theme");
            else localStorage.setItem("theme", target);
          } catch {
            /* storage blocked: the scheme still applies for this page view */
          }
          applyScheme(storedScheme());
          window.clearTimeout(themeTransitionTimeout);
          themeTransitionTimeout = window.setTimeout(() => {
            document.documentElement.classList.remove("theme-transition");
          }, 260);
        });
      });

      // The OS preference can change at any time (including on a schedule).
      darkQuery.addEventListener("change", () => applyScheme(storedScheme()));

      // Keep other tabs in sync with an override made here.
      window.addEventListener("storage", (event) => {
        if (event.key === "theme") applyScheme(storedScheme());
      });

      syncThemeControls();
    </script>
  </body>
</html>
